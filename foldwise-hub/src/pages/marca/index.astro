---
import HubLayout from '../../layouts/HubLayout.astro';
import Section from '../../components/hub/Section.astro';
import Wordmark from '../../components/brand/Wordmark.astro';
import Isotype from '../../components/brand/Isotype.astro';
import AnimatedLogo from '../../components/brand/AnimatedLogo.astro';
import Swatch from '../../components/brand/Swatch.astro';
import Pattern from '../../components/brand/Pattern.astro';
import Icon from '../../components/brand/Icon.astro';
import PaletteStudy from '../../components/brand/explored/PaletteStudy.astro';
import IsotypeStudy from '../../components/brand/explored/IsotypeStudy.astro';
import { palette, taglines, voice, ISOTYPE_PATH } from '../../data/brand';
import { minOrderUnits } from '../../data/categories';
import IgFeedGrid from '../../components/brand/social/IgFeedGrid.astro';
import IgPost from '../../components/brand/social/IgPost.astro';
import IgCarousel from '../../components/brand/social/IgCarousel.astro';
import IgStory from '../../components/brand/social/IgStory.astro';
import { feed } from '../../data/social';

const chapters = [
  { id: 'la-marca', num: '01', title: 'La marca' },
  { id: 'nombre', num: '02', title: 'Nombre' },
  { id: 'logo', num: '03', title: 'Logo' },
  { id: 'logo-animado', num: '04', title: 'Logo animado' },
  { id: 'color', num: '05', title: 'Color' },
  { id: 'tipografia', num: '06', title: 'Tipografía' },
  { id: 'iconos', num: '07', title: 'Íconos' },
  { id: 'patrones', num: '08', title: 'Patrones' },
  { id: 'voz', num: '09', title: 'Voz de marca' },
  { id: 'redes', num: '10', title: 'Redes sociales' },
  { id: 'direcciones', num: '11', title: 'Direcciones exploradas' },
  { id: 'proximos-pasos', num: '12', title: 'Próximos pasos' },
] as const;
const ch = Object.fromEntries(chapters.map((c) => [c.id, c])) as Record<(typeof chapters)[number]['id'], (typeof chapters)[number]>;

const differentiators = [
  { icon: 'pedido-pequeno', label: 'Pedidos pequeños', text: `Desde ${minOrderUnits} cajas, para que empieces con lo justo.` },
  { icon: 'rapido', label: 'Entrega rápida', text: 'Para que tu lanzamiento no espere.' },
  { icon: 'asesoria', label: 'Atención personalizada', text: 'Una persona real que conoce tu pedido.' },
  { icon: 'personaliza', label: 'Personalización', text: 'Tu logo en la caja, desde el primer pedido.' },
  { icon: 'medida', label: 'A la medida', text: 'Si tu producto es raro, la caja no tiene por qué serlo.' },
  { icon: 'envio', label: 'Precio competitivo', text: 'Precio competitivo, con descuento por volumen.' },
] as const;

const versions = [
  { variant: 'crema', bg: palette.crema, label: 'Sobre crema', note: 'Versión principal. Ciruela con pliegues lima.' },
  { variant: 'ciruela', bg: palette.ciruela, label: 'Sobre ciruela', note: 'Crema con pliegues ciruela, para fondos oscuros.' },
  { variant: 'kraft', bg: palette.kraft, label: 'Sobre kraft', note: 'Impresa directo sobre el cartón natural.' },
  { variant: 'lima', bg: palette.lima, label: 'Sobre lima', note: 'Solo en piezas de celebración: cinta y stickers.' },
] as const;

const misuses = [
  { kind: 'stretch', text: 'No lo estires ni lo comprimas.' },
  { kind: 'rotate', text: 'No lo gires.' },
  { kind: 'recolor', text: 'No cambies sus colores.' },
  { kind: 'effects', text: 'No le agregues sombras ni contornos.' },
  { kind: 'font', text: 'No cambies la tipografía.' },
  { kind: 'busy', text: 'No lo pongas sobre fondos que compitan.' },
] as const;

const primary = [
  { name: 'Crema', hex: palette.crema, role: 'Base', why: 'El fondo de todo. Más cálido que el blanco, se siente a papel.' },
  { name: 'Kraft', hex: palette.kraft, role: 'Material', why: 'El color real del cartón. La marca nunca lo esconde.' },
  { name: 'Ciruela', hex: palette.ciruela, role: 'Principal', why: 'Profundo y poco común en la categoría: confianza sin frialdad.' },
  { name: 'Lima', hex: palette.lima, role: 'Acento', why: 'La chispa. Solo donde hay acción o celebración.' },
];
const support = [
  { name: 'Ciruela claro', hex: palette.ciruelaClaro },
  { name: 'Ciruela sombra', hex: palette.ciruelaSombra },
  { name: 'Kraft claro', hex: palette.kraftClaro },
  { name: 'Kraft sombra', hex: palette.kraftSombra },
];

const typeScale = [
  { cls: 'display', name: 'Display', spec: 'Bricolage Grotesque 800, 112 px, interlineado 0,9', sample: 'foldwise' },
  { cls: 'h1', name: 'Titular', spec: 'Bricolage Grotesque 800, 64 px, interlineado 1,0', sample: 'Cuidado enorme.' },
  { cls: 'h2', name: 'Subtítulo', spec: 'Bricolage Grotesque 700, 24 px, interlineado 1,2', sample: 'Empieza con 25 cajas.' },
  { cls: 'body', name: 'Texto', spec: 'Figtree 400, 17 px, interlineado 1,6', sample: 'Cuando crezcas, el precio baja contigo. Y si tienes dudas, te ayudamos a elegir la caja.' },
  { cls: 'note', name: 'Nota', spec: 'Figtree 600, 13 px, interlineado 1,35', sample: 'Hecho con cuidado, desde la primera caja.' },
] as const;

const icons = [
  { name: 'pedido-pequeno', label: 'Pedidos pequeños' },
  { name: 'envio', label: 'Envío' },
  { name: 'rapido', label: 'Entrega rápida' },
  { name: 'personaliza', label: 'Personaliza' },
  { name: 'medida', label: 'A la medida' },
  { name: 'armado', label: 'Fácil de armar' },
  { name: 'asesoria', label: 'Asesoría' },
  { name: 'eco', label: 'Reciclable' },
] as const;

// "Redes sociales": the four formats, drawn to scale with their safe zones.
const SAFE = 72; // px of margin on a 1080 px wide canvas
const templates = [
  { id: 'post-1x1', name: 'Post cuadrado', ratio: '1 / 1', size: '1080 × 1080 px', use: 'Frases y anuncios cortos.', bands: 0 },
  { id: 'post-4x5', name: 'Post vertical', ratio: '4 / 5', size: '1080 × 1350 px', use: 'El formato por defecto del feed: ocupa más pantalla.', bands: 0 },
  { id: 'story', name: 'Historia', ratio: '9 / 16', size: '1080 × 1920 px', use: 'Deja libres 250 px arriba y abajo para la interfaz.', bands: 250 / 1920 },
  { id: 'carousel', name: 'Carrusel', ratio: '4 / 5', size: '1080 × 1350 px por lámina', use: 'De 3 a 5 láminas, una idea por lámina.', bands: 0 },
] as const;
const unboxing = feed.find((p) => p.id === 'unboxing')!;

const traits = ['Amigable', 'Cercana', 'Joven', 'Vibrante', 'Atenta'];

const animSteps = [
  'Aparece la f plana y se dibujan los pliegues lima.',
  'Las solapas giran sobre sus pliegues y el tronco se enrolla en las paredes de una caja.',
  'La tapa baja y su lengüeta entra: una sola pieza de cartón, sin fundidos.',
  'La cinta lima sella el borde y la f queda impresa en el costado.',
  'La caja se despliega y vuelve a ser f, lista para empezar otra vez.',
];

const nextSteps = [
  {
    title: 'Validación legal del nombre',
    text: 'Búsqueda de anterioridades en la USPTO con un abogado de marcas y, si el camino está libre, la solicitud de registro. Si no, ajustamos a tiempo.',
  },
  {
    title: 'Identidad final',
    text: 'Refinamos nombre, logo y color con tu retroalimentación, y cerramos el sistema con artes finales listos para producción.',
  },
  {
    title: 'Sistema completo de packaging',
    text: 'Artes para las 12 cajas, troqueles a escala, cinta, papel de seda, stickers y una guía de impresión para tu planta.',
  },
  {
    title: 'Fotografía real',
    text: 'Sesión de producto y de estilo de vida con emprendedores reales empacando, para reemplazar las imágenes de muestra.',
  },
  {
    title: 'E-commerce en producción',
    text: 'El sitio que viste, conectado a catálogo, precios reales, carrito y pagos, y medido desde el primer día.',
  },
  {
    title: 'Lanzamiento en EE. UU.',
    text: 'Versión en inglés de todo el sistema, voz adaptada al mercado, redes y un kit de lanzamiento para los primeros clientes.',
  },
];
---

<HubLayout
  title="Foldwise · Manual de marca"
  description="El manual de marca de Foldwise: nombre, logo, color, tipografía, íconos, patrones, voz y el porqué de cada decisión."
>
  <main class="manual">
    <header class="cover" aria-labelledby="h-cover">
      <div class="cover__pattern" aria-hidden="true">
        <Pattern kind="troquel" color={palette.ciruelaClaro} bg={palette.ciruela} scale={1.6} />
      </div>
      <div class="cover__inner">
        <div class="cover__run">
          <a class="cover__back" href="/">Volver al hub</a>
          <span>Versión 1.0, noviembre de 2026</span>
        </div>
        <div class="cover__grid">
          <div class="cover__copy">
            <Wordmark variant="ciruela" size={36} withIsotype />
            <h1 id="h-cover" class="cover__title">Manual<br />de marca</h1>
            <p class="cover__tagline">{taglines.principal}</p>
            <p class="cover__lede">
              Todo lo que hace que Foldwise se vea, suene y se sienta como Foldwise, y el porqué detrás de cada decisión.
              Es una propuesta: nombre, colores y logo pueden ajustarse contigo.
            </p>
          </div>
          <div class="cover__mark">
            <AnimatedLogo variant="ciruela" size={500} trigger="load" loop />
          </div>
        </div>
        <p class="cover__credit">Propuesta de marca por Simian</p>
      </div>
    </header>

    <div class="manual__layout">
      <nav class="index" data-manual-nav aria-label="Índice del manual">
        <p class="index__title">Índice</p>
        <ol class="index__list" role="list">
          {
            chapters.map((c) => (
              <li>
                <a href={`#${c.id}`}>
                  <span class="index__num">{c.num}</span>
                  {c.title}
                </a>
              </li>
            ))
          }
        </ol>
        <div class="index__more">
          <a href="/marca/en-accion">La marca en acción</a>
          <a href="/marca/cajas">Las 12 cajas</a>
        </div>
      </nav>

      <div class="sheets">
        {/* 01 ------------------------------------------------------------ */}
        <Section {...ch['la-marca']}>
          <Fragment slot="aside">
            <p>Foldwise es el aliado de packaging de los negocios que están arrancando.</p>
            <p>
              Vende cajas de cartón corrugado listas para armar en Estados Unidos, a pymes, pequeños comerciantes y tiendas en
              línea que necesitan cajas buenas sin pedir miles.
            </p>
          </Fragment>
          <blockquote class="promise">
            <p>Ser pequeño no te hace cliente secundario.</p>
            <footer>La promesa de Foldwise</footer>
          </blockquote>
          <div class="rows">
            <article>
              <h3>Historia</h3>
              <p>
                Detrás de Foldwise hay un fabricante con experiencia en cartón corrugado: materiales, maquinaria y oficio propios.
                En Estados Unidos vio una demanda enorme que todavía busca un aliado cercano: el negocio que arranca y necesita 50 cajas,
                no 5.000. Foldwise nace como una marca nueva, hecha solo para ellos.
              </p>
            </article>
            <article>
              <h3>El porqué del nombre</h3>
              <p>
                Fold, doblar, más wise, con inteligencia. Las cajas llegan con pliegues marcados y se arman en segundos, y
                detrás hay alguien que te orienta. El nombre dice qué hacemos y cómo lo hacemos.
              </p>
            </article>
            <article>
              <h3>Posicionamiento</h3>
              <p>
                Entre el catálogo industrial amplio y sólido y las marcas cercanas para emprendedores. Tomamos la solidez del
                primero y la calidez del segundo: un catálogo serio que te dice hazla tuya.
              </p>
            </article>
          </div>
          <figure class="spectrum" aria-label="Mapa de posicionamiento">
            <div class="spectrum__track">
              <span class="spectrum__end">Catálogo industrial<small>Amplio y sólido, pero frío</small></span>
              <span class="spectrum__dot" aria-hidden="true"><Isotype variant="lima" size={30} label="" /></span>
              <span class="spectrum__end spectrum__end--right">Marcas para emprendedores<small>Cercanas, pero limitadas</small></span>
            </div>
            <figcaption>Foldwise ocupa el centro: la solidez del fabricante con el trato de quien te conoce.</figcaption>
          </figure>
          <ul class="diffs" role="list">
            {
              differentiators.map((d) => (
                <li>
                  <Icon name={d.icon} size={28} />
                  <b>{d.label}</b>
                  <span>{d.text}</span>
                </li>
              ))
            }
          </ul>
        </Section>

        {/* 02 ------------------------------------------------------------ */}
        <Section {...ch['nombre']}>
          <Fragment slot="aside">
            <p>Un nombre corto, fácil de decir en inglés y con el producto adentro.</p>
            <p>
              En un mercado lleno de nombres genéricos de bodega, Foldwise suena a marca, no a proveedor. Y se entiende sin
              explicación: algo que se dobla, bien hecho.
            </p>
          </Fragment>
          <div class="name-eq" aria-label="Fold más wise es Foldwise">
            <div><span class="name-eq__word">fold</span><span class="name-eq__gloss">doblar</span></div>
            <span class="name-eq__op" aria-hidden="true">+</span>
            <div><span class="name-eq__word">wise</span><span class="name-eq__gloss">con inteligencia</span></div>
            <span class="name-eq__op" aria-hidden="true">=</span>
            <div class="name-eq__result">
              <Wordmark variant="crema" size={44} />
              <span class="name-eq__gloss">Doblar con inteligencia</span>
            </div>
          </div>
          <div class="cols2">
            <article class="name-card" data-name="foldwise">
              <h3>Foldwise</h3>
              <p>
                El producto se arma con pliegues claros, y wise evoca al asesor que te orienta: atención personalizada y
                cajas a la medida. Funciona en inglés para el cliente estadounidense y se pronuncia sin dudar.
              </p>
            </article>
            <article class="name-card name-card--rejected" data-name="ridgeline">
              <span class="name-card__tag">Descartado</span>
              <h3><s>Ridgeline</s></h3>
              <p>
                Venía de las crestas del corrugado, la onda que le da fuerza al cartón. Lo descartamos porque choca con la
                camioneta Honda Ridgeline: en Estados Unidos, el nombre ya tiene dueño en la mente de la gente.
              </p>
            </article>
          </div>
          <aside class="legal" data-legal-note aria-label="Nota legal">
            <h3>Pendiente: verificación legal</h3>
            <p>
              Existe la solicitud USPTO “FOLDWISE” (serial 99663592, febrero de 2026, clase sin confirmar) y el registro “F
              FOLDWISE” (clase 20, muebles). Hay que verificarlo con un abogado de marcas antes de la aprobación final. Si hace
              falta, dos salidas naturales: Foldwise Box Co. o Foldwise Packaging.
            </p>
          </aside>
        </Section>

        {/* 03 ------------------------------------------------------------ */}
        <Section {...ch['logo']}>
          <Fragment slot="aside">
            <p>La f de Foldwise es un despiece de caja.</p>
            <p>
              Sus solapas tienen el chaflán de un troquel real y las líneas punteadas marcan dónde se doblan. Es la inicial y
              es el producto, en una sola forma.
            </p>
            <p>El logotipo va en minúsculas, en Bricolage Grotesque 800 con interletrado ajustado: cercano, nunca gritón.</p>
          </Fragment>
          <div class="logo-hero">
            <div class="logo-hero__lockup"><Wordmark variant="crema" size={80} withIsotype /></div>
            <figure class="construct">
              <svg viewBox="-6 -4 58 54" role="img" aria-label="Construcción del isotipo">
                <defs>
                  <pattern id="construct-grid" width="2" height="2" patternUnits="userSpaceOnUse">
                    <path d="M2 0H0V2" fill="none" stroke="#3A1D3F" stroke-width="0.06" opacity="0.35"></path>
                  </pattern>
                </defs>
                <rect x="0" y="0" width="46" height="46" fill="url(#construct-grid)"></rect>
                <rect x="0" y="0" width="46" height="46" fill="none" stroke="#3A1D3F" stroke-width="0.15" opacity="0.4"></rect>
                <path d={ISOTYPE_PATH} fill="#3A1D3F" opacity="0.92"></path>
                <path d="M25 4v8 M15 19v8 M25 19v8" fill="none" stroke="#C8F25A" stroke-width="1.1" stroke-dasharray="1.6 1.3"></path>
                <g fill="none" stroke="#3A1D3F" stroke-width="0.25">
                  <path d="M36 9L41 6"></path>
                  <path d="M8 21L3 17"></path>
                  <path d="M25 23L41 31"></path>
                </g>
                <g font-family="Figtree, sans-serif" font-size="2.4" font-weight="700" fill="#3A1D3F">
                  <circle cx="43" cy="5" r="2.2" fill="#F6F1E7" stroke="#3A1D3F" stroke-width="0.25"></circle>
                  <text x="43" y="5.85" text-anchor="middle">1</text>
                  <circle cx="1.5" cy="15.5" r="2.2" fill="#F6F1E7" stroke="#3A1D3F" stroke-width="0.25"></circle>
                  <text x="1.5" y="16.35" text-anchor="middle">2</text>
                  <circle cx="43" cy="32" r="2.2" fill="#F6F1E7" stroke="#3A1D3F" stroke-width="0.25"></circle>
                  <text x="43" y="32.85" text-anchor="middle">3</text>
                </g>
              </svg>
              <figcaption>
                <ol role="list">
                  <li>Chaflán de troquel en cada solapa.</li>
                  <li>Solapas laterales que se doblan hacia el tronco.</li>
                  <li>Pliegues punteados donde la solapa se une al tronco.</li>
                </ol>
              </figcaption>
            </figure>
          </div>

          <div class="block">
            <h3>Versiones</h3>
            <ul class="versions" role="list">
              {
                versions.map((v) => (
                  <li data-logo-version={v.variant}>
                    <div class="versions__tile" style={`background:${v.bg}`}>
                      <Wordmark variant={v.variant} size={22} withIsotype />
                    </div>
                    <b>{v.label}</b>
                    <span>{v.note}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="cols2 cols2--top">
            <div class="block">
              <h3>Zona de protección</h3>
              <div class="clear">
                <div class="clear__frame">
                  <span class="clear__x clear__x--t" aria-hidden="true">x</span>
                  <span class="clear__x clear__x--l" aria-hidden="true">x</span>
                  <span class="clear__x clear__x--r" aria-hidden="true">x</span>
                  <span class="clear__x clear__x--b" aria-hidden="true">x</span>
                  <div class="clear__logo"><Wordmark variant="crema" size={40} withIsotype /></div>
                </div>
              </div>
              <p class="small">
                Deja libre alrededor, como mínimo, el ancho de la solapa superior del isotipo (x). Ningún texto, borde o imagen
                entra en esa zona.
              </p>
            </div>
            <div class="block">
              <h3>Tamaño mínimo</h3>
              <div class="minsize">
                <div class="minsize__item">
                  <Wordmark variant="crema" size={18} withIsotype />
                  <span>24 px de alto en pantalla<br />10 mm en impresión</span>
                </div>
                <div class="minsize__item">
                  <Isotype variant="crema" size={16} label="Isotipo en tamaño mínimo" />
                  <span>Isotipo solo: 16 px<br />6 mm en impresión</span>
                </div>
              </div>
              <p class="small">
                Por debajo de estos tamaños los pliegues punteados se pierden. En favicon y redes, el isotipo va solo.
              </p>
            </div>
          </div>

          <div class="block">
            <h3>Usos incorrectos</h3>
            <ul class="misuse" role="list">
              {
                misuses.map((m) => (
                  <li data-misuse={m.kind}>
                    <div class:list={['misuse__tile', `misuse__tile--${m.kind}`]}>
                      {m.kind === 'busy' && (
                        <div class="misuse__bg" aria-hidden="true">
                          <Pattern kind="flauta" color={palette.ciruela} bg={palette.kraft} scale={0.55} />
                        </div>
                      )}
                      {m.kind === 'font' ? (
                        <span class="misuse__font" aria-hidden="true">
                          <Isotype variant="crema" size={26} label="" />
                          <span>Foldwise</span>
                        </span>
                      ) : (
                        <span class="misuse__logo">
                          <Wordmark variant="crema" size={18} withIsotype />
                        </span>
                      )}
                      <span class="misuse__x" aria-hidden="true">
                        <svg viewBox="0 0 12 12" width="12" height="12">
                          <path d="M3 3l6 6M9 3l-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                        </svg>
                      </span>
                    </div>
                    <span>{m.text}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </Section>

        {/* 04 ------------------------------------------------------------ */}
        <Section {...ch['logo-animado']}>
          <Fragment slot="aside">
            <p>La f se dobla y se vuelve caja. Es la marca contando, en menos de diez segundos, lo que hace.</p>
            <p>
              Es un pliegue real: la f es el troquel y cada solapa gira sobre su línea punteada. Se usa en la
              intro y la carga del sitio, al pasar el cursor por el logo del header y como firma de este manual.
            </p>
          </Fragment>
          <div class="anim">
            <div class="anim__stage anim__stage--light">
              <AnimatedLogo variant="crema" size={340} trigger="view" loop />
            </div>
            <div class="anim__stage anim__stage--dark">
              <AnimatedLogo variant="ciruela" size={220} trigger="view" loop />
              <span>Sobre ciruela, la caja es kraft: el producto real.</span>
            </div>
          </div>
          <ol class="steps" role="list">
            {
              animSteps.map((s, i) => (
                <li>
                  <span class="steps__num">{i + 1}</span>
                  {s}
                </li>
              ))
            }
          </ol>
          <p class="small">
            Con movimiento reducido activado en el sistema, el logo se muestra quieto. Para redes puede exportarse como video.
          </p>
        </Section>

        {/* 05 ------------------------------------------------------------ */}
        <Section {...ch['color']}>
          <Fragment slot="aside">
            <p>Una base tranquila y un acento con energía.</p>
            <p>
              Crema, kraft y ciruela sostienen la marca y la hacen sentir premium. La lima es la chispa: aparece solo donde
              hay una acción o una emoción. Frente a la paleta habitual de la categoría, de marrones y verdes, el ciruela con
              lima es difícil de confundir.
            </p>
            <p>
              Los valores CMYK son una conversión aproximada. Antes de imprimir, pide una prueba de color a la imprenta.
            </p>
          </Fragment>
          <div class="swatches">
            {
              primary.map((c) => (
                <div class="swatches__item">
                  <Swatch name={c.name} hex={c.hex} role={c.role} tier="primary" />
                  <p class="small">{c.why}</p>
                </div>
              ))
            }
          </div>
          <div class="rule" data-rule-8020>
            <h3>Regla 80/20</h3>
            <div class="rule__dims" aria-hidden="true">
              <span style="flex:80">80%</span>
              <span style="flex:20">20%</span>
            </div>
