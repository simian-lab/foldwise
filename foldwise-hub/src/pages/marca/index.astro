    font-size: clamp(3.5rem, 1rem + 9vw, 9.5rem);
    line-height: 0.86;
    letter-spacing: -0.045em;
    margin-top: var(--s-4);
  }
  .cover__tagline {
    margin: 0;
    font-family: var(--f-display);
    font-weight: 700;
    font-size: var(--fs-xl);
    letter-spacing: -0.025em;
    line-height: 1.1;
    color: var(--c-lima);
  }
  .cover__lede {
    margin: 0;
    max-width: 46ch;
    color: rgb(246 241 231 / 0.82);
  }
  .cover__mark {
    display: grid;
    place-items: center;
    min-width: 0;
  }
  /* shrink with the column instead of clipping (the logo's height is fixed by --al-size) */
  .cover__mark :global([data-animated-logo]) {
    width: min(100%, 500px);
    height: auto;
  }
  .cover__credit {
    margin: 0;
    font-size: var(--fs-xs);
    font-weight: 600;
    color: rgb(246 241 231 / 0.75);
  }

  /* Layout + index ---------------------------------------------------- */
  .manual__layout {
    max-width: 1360px;
    margin: 0 auto;
    padding: var(--s-8) clamp(1rem, 0.5rem + 2.5vw, 3rem) 0;
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: var(--s-8);
    align-items: start;
  }
  .index {
    position: sticky;
    top: var(--s-6);
    display: grid;
    gap: var(--s-4);
    font-size: var(--fs-sm);
  }
  .index__title {
    margin: 0;
    font-family: var(--f-display);
    font-weight: 700;
  }
  .index__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }
  .index__list a,
  .index__more a {
    display: flex;
    gap: var(--s-3);
    padding: 5px 8px;
    margin-left: -8px;
    border-radius: var(--r-sm);
    text-decoration: none;
    line-height: 1.3;
  }
  .index__list a:hover,
  .index__more a:hover {
    background: var(--c-crema);
  }
  .index__num {
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    opacity: 0.55;
    min-width: 1.4em;
  }
  .index__more {
    display: grid;
    gap: 2px;
    padding-top: var(--s-4);
    border-top: 1px dashed rgb(58 29 63 / 0.3);
    font-weight: 600;
  }
  .sheets {
    display: grid;
    gap: var(--s-6);
    min-width: 0;
  }

  /* 01 ---------------------------------------------------------------- */
  .promise {
    margin: 0;
    padding: 0;
  }
  .promise p {
    margin: 0;
    font-family: var(--f-display);
    font-weight: 800;
    font-size: clamp(2rem, 1rem + 3.4vw, 3.75rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
    max-width: 15ch;
  }
  .promise footer {
    margin-top: var(--s-3);
    font-size: var(--fs-xs);
    font-weight: 600;
  }
  .spectrum {
    margin: 0;
    display: grid;
    gap: var(--s-3);
  }
  .spectrum__track {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-4);
    padding: var(--s-6) 0;
    border-top: 2px solid var(--c-ciruela);
  }
  .spectrum__end {
    display: grid;
    font-family: var(--f-display);
    font-weight: 700;
    font-size: var(--fs-sm);
    line-height: 1.2;
    max-width: 14em;
  }
  .spectrum__end small {
    font-family: var(--f-text);
    font-weight: 400;
    font-size: var(--fs-xs);
    opacity: 0.75;
  }
  .spectrum__end--right {
    text-align: right;
  }
  .spectrum__dot {
    position: absolute;
    left: 50%;
    top: -2px;
    transform: translate(-50%, -50%);
    background: var(--c-lima);
    border-radius: 50%;
    padding: 10px;
    box-shadow: 0 0 0 6px var(--c-crema);
  }
  .spectrum figcaption {
    font-size: var(--fs-sm);
    font-weight: 600;
    text-align: center;
  }
  .diffs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-6) var(--s-8);
  }
  .diffs li {
    display: grid;
    gap: 4px;
    align-content: start;
    font-size: var(--fs-sm);
    line-height: 1.4;
  }
  .diffs li :global(svg) {
    margin-bottom: var(--s-2);
  }
  .diffs span {
    color: rgb(58 29 63 / 0.78);
  }

  /* 02 ---------------------------------------------------------------- */
  .name-eq {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--s-4) var(--s-6);
    padding: var(--s-8) 0;
    border-block: 1px dashed rgb(58 29 63 / 0.3);
  }
  .name-eq > div {
    display: grid;
    gap: var(--s-2);
  }
  .name-eq__word {
    font-family: var(--f-display);
    font-weight: 800;
    font-size: 44px;
    letter-spacing: -0.035em;
    line-height: 1;
  }
  .name-eq__op {
    font-family: var(--f-display);
    font-size: 44px;
    line-height: 1;
    font-weight: 500;
    opacity: 0.45;
  }
  .name-eq__gloss {
    font-size: var(--fs-xs);
    font-weight: 600;
    opacity: 0.75;
  }
  .name-eq__result .name-eq__gloss {
    opacity: 1;
  }
  .name-card {
    position: relative;
    padding: var(--s-6);
    border-radius: var(--r-md);
    background: var(--paper-bg);
  }
  .name-card {
    align-content: start;
  }
  .name-card h3 {
    font-size: var(--fs-xl);
    font-weight: 800;
  }
  .name-card--rejected {
    background: transparent;
    box-shadow: inset 0 0 0 1px rgb(58 29 63 / 0.2);
  }
  .name-card--rejected h3 {
    opacity: 0.55;
  }
  .name-card__tag {
    display: inline-block;
    margin-bottom: var(--s-3);
    font-size: var(--fs-xs);
    font-weight: 700;
    padding: 2px 10px;
    border-radius: var(--r-pill);
    box-shadow: inset 0 0 0 1.5px currentColor;
  }
  .legal {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--s-2) var(--s-6);
    padding: var(--s-6);
    border-radius: var(--r-md);
    background: var(--c-ciruela);
    color: var(--c-crema);
  }
  .legal::before {
    content: '';
    grid-row: span 2;
    width: 6px;
    border-radius: 3px;
    background: repeating-linear-gradient(180deg, var(--c-lima) 0 6px, transparent 6px 11px);
  }
  .legal p {
    margin: 0;
    font-size: var(--fs-sm);
    color: rgb(246 241 231 / 0.86);
  }

  /* 03 ---------------------------------------------------------------- */
  .logo-hero {
    display: grid;
    gap: var(--s-6);
  }
  .logo-hero__lockup {
    display: grid;
    place-items: center;
    min-height: 320px;
    border-radius: var(--r-md);
    background: var(--paper-bg);
    padding: var(--s-8);
    overflow: hidden;
  }
  .construct {
    margin: 0;
    display: grid;
    grid-template-columns: minmax(0, 280px) minmax(0, 1fr);
    gap: var(--s-8);
    align-items: center;
  }
  .construct svg {
    width: 100%;
    height: auto;
    max-width: 320px;
  }
  .construct ol {
    margin: 0;
    padding-left: 1.3em;
    display: grid;
    gap: var(--s-2);
    font-size: var(--fs-sm);
    line-height: 1.45;
  }
  .versions {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-4);
  }
  .versions li {
    display: grid;
    gap: 4px;
    align-content: start;
    font-size: var(--fs-xs);
    line-height: 1.4;
  }
  .versions b {
    font-size: var(--fs-sm);
    margin-top: var(--s-2);
  }
  .versions span {
    color: rgb(58 29 63 / 0.78);
  }
  .versions__tile {
    aspect-ratio: 4 / 3;
    border-radius: var(--r-md);
    display: grid;
    place-items: center;
    box-shadow: inset 0 0 0 1px rgb(58 29 63 / 0.1);
    overflow: hidden;
    padding: var(--s-3);
  }
  .clear {
    display: grid;
    place-items: center;
    padding: var(--s-8) var(--s-4);
    border-radius: var(--r-md);
    background: var(--paper-bg);
    overflow: hidden;
  }
  .clear__frame {
    /* x = width of the isotype's top flap: 11 of its 46 units, at a 54 px mark */
    --x: 13px;
    position: relative;
    padding: var(--x);
    outline: 1px dashed var(--c-ciruela);
    background: repeating-linear-gradient(45deg, rgb(58 29 63 / 0.07) 0 2px, transparent 2px 7px);
  }
  .clear__logo {
    background: var(--paper-bg);
    box-shadow: 0 0 0 1px rgb(58 29 63 / 0.35);
  }
  .clear__x {
    position: absolute;
    font-size: 11px;
    font-weight: 700;
    line-height: 1;
  }
  .clear__x--t { top: 1px; left: 50%; transform: translateX(-50%); }
  .clear__x--b { bottom: 1px; left: 50%; transform: translateX(-50%); }
  .clear__x--l { left: 3px; top: 50%; transform: translateY(-50%); }
  .clear__x--r { right: 3px; top: 50%; transform: translateY(-50%); }
  .minsize {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-4);
    padding: var(--s-6);
    border-radius: var(--r-md);
    background: var(--paper-bg);
  }
  .minsize__item {
    display: grid;
    gap: var(--s-3);
    align-content: start;
    justify-items: start;
    font-size: var(--fs-xs);
    line-height: 1.4;
    font-weight: 600;
  }
  .misuse {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-6) var(--s-4);
  }
  .misuse li {
    display: grid;
    gap: var(--s-2);
    font-size: var(--fs-xs);
    font-weight: 600;
    line-height: 1.35;
  }
  .misuse__tile {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--r-md);
    background: var(--paper-bg);
    display: grid;
    place-items: center;
    overflow: hidden;
    isolation: isolate;
  }
  .misuse__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .misuse__x {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 22px;
    height: 22px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--c-ciruela);
    color: var(--c-crema);
  }
  .misuse__tile--stretch .misuse__logo { transform: scaleX(1.4) scaleY(0.85); }
  .misuse__tile--rotate .misuse__logo { transform: rotate(-16deg); }
  .misuse__tile--recolor .misuse__logo { filter: hue-rotate(150deg) saturate(1.6); }
  .misuse__tile--effects .misuse__logo {
    filter: drop-shadow(3px 3px 0 var(--c-kraft)) drop-shadow(0 0 1px var(--c-lima)) drop-shadow(0 0 1px var(--c-lima));
  }
  .misuse__font {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
    font-size: 22px;
  }

  /* 04 ---------------------------------------------------------------- */
  .anim {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: var(--s-4);
  }
  .anim__stage {
    border-radius: var(--r-md);
    display: grid;
    place-items: center;
    padding: var(--s-6);
    min-height: 380px;
    overflow: hidden;
  }
  .anim__stage :global([data-animated-logo]) {
    max-width: 100%;
  }
  .anim__stage--light {
    background: var(--paper-bg);
  }
  .anim__stage--dark span {
    max-width: 22ch;
  }
  .anim__stage--dark {
    background: var(--c-ciruela);
    color: var(--c-crema);
    align-content: center;
    gap: var(--s-4);
    text-align: center;
    font-size: var(--fs-xs);
    font-weight: 600;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--s-4);
  }
  .steps li {
    display: grid;
    gap: var(--s-2);
    align-content: start;
    font-size: var(--fs-xs);
    line-height: 1.45;
    padding-top: var(--s-3);
    border-top: 1px dashed rgb(58 29 63 / 0.35);
  }
  .steps__num {
    font-family: var(--f-display);
    font-weight: 800;
    font-size: var(--fs-lg);
    line-height: 1;
  }

  /* 05 ---------------------------------------------------------------- */
  .swatches {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-4);
  }
  .swatches__item {
    display: grid;
    gap: var(--s-3);
    align-content: start;
  }
  .rule {
    display: grid;
    gap: var(--s-4);
  }
  .rule__bar {
    display: flex;
    height: 56px;
    border-radius: var(--r-md);
    overflow: hidden;
    box-shadow: inset 0 0 0 1px rgb(58 29 63 / 0.12);
  }
  .rule__bar {
    border: 1px solid rgb(58 29 63 / 0.18);
  }
  .rule__dims {
    display: flex;
    gap: 6px;
    font-family: var(--f-display);
    font-weight: 800;
    font-size: var(--fs-lg);
    line-height: 1;
  }
  .rule__dims span {
    padding-bottom: var(--s-2);
    border-bottom: 2px solid var(--c-ciruela);
  }
  .rule__dims span:last-child {
    border-bottom: 2px dashed var(--c-ciruela);
  }
  .rule__legend {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 1fr);
    gap: var(--s-6);
  }
  .rule__legend p {
    margin: 0;
    font-size: var(--fs-sm);
    line-height: 1.45;
  }
  .rule__legend p:first-child {
    max-width: 48ch;
  }
  .rule__legend p:last-child {
    grid-column: 1 / -1;
    justify-self: end;
    text-align: right;
    max-width: 40ch;
  }
  .support {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-4);
  }

  /* 06 ---------------------------------------------------------------- */
  .faces {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-4);
  }
  .face {
    padding: var(--s-6);
    border-radius: var(--r-md);
    background: var(--paper-bg);
    display: grid;
    gap: var(--s-2);
    align-content: start;
    min-width: 0;
  }
  .face--text {
    background: var(--c-ciruela);
    color: var(--c-crema);
  }
  .face--text .small {
    color: rgb(246 241 231 / 0.75);
  }
  .face__aa {
    font-family: var(--f-display);
    font-weight: 800;
    font-size: clamp(6rem, 3rem + 8vw, 11rem);
    line-height: 0.9;
    letter-spacing: -0.05em;
  }
  .face--text .face__aa {
    font-family: var(--f-text);
    font-weight: 500;
    letter-spacing: -0.03em;
  }
  .face__name {
    margin: var(--s-4) 0 0;
    font-family: var(--f-display);
    font-weight: 700;
    font-size: var(--fs-lg);
    line-height: 1.1;
  }
  .face--text .face__name,
  .face--text .face__glyphs {
    font-family: var(--f-text);
  }
  .face__glyphs {
    margin: var(--s-3) 0 0;
    font-family: var(--f-display);
    font-weight: 500;
    font-size: var(--fs-sm);
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  .scale {
    margin: 0;
    display: grid;
  }
  .scale__row {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 7fr);
    gap: var(--s-6);
    align-items: baseline;
    padding: var(--s-4) 0;
    border-top: 1px dashed rgb(58 29 63 / 0.25);
  }
  .scale__row dt {
    display: grid;
    font-size: var(--fs-xs);
    line-height: 1.4;
  }
  .scale__row dt span {
    color: rgb(58 29 63 / 0.72);
  }
  .scale__sample {
    margin: 0;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .scale__sample--display {
    font-family: var(--f-display);
    font-weight: 800;
    font-size: clamp(3rem, 1rem + 4.6vw, 6rem);
    line-height: 0.9;
    letter-spacing: -0.035em;
    overflow-wrap: normal;
  }
  .scale__sample--h1 {
    font-family: var(--f-display);
    font-weight: 800;
    font-size: var(--fs-2xl);
    line-height: 1;
    letter-spacing: -0.035em;
  }
  .scale__sample--h2 {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 1.5rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
  .scale__sample--body {
    font-size: var(--fs-body);
    line-height: 1.6;
    max-width: 52ch;
  }
  .scale__sample--note {
    font-size: var(--fs-xs);
    font-weight: 600;
  }

  /* 07 ---------------------------------------------------------------- */
  .icon-hero {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--s-8);
    align-items: center;
  }
  .icon-hero__grid {
    margin: 0;
    padding: 24px;
    border-radius: var(--r-md);
    background-color: var(--paper-bg);
    background-image:
      linear-gradient(rgb(58 29 63 / 0.12) 1px, transparent 1px),
      linear-gradient(90deg, rgb(58 29 63 / 0.12) 1px, transparent 1px);
    background-size: 7px 7px;
    background-position: 24px 24px;
  }
  .spec {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-3);
    font-size: var(--fs-sm);
  }
  .spec li {
    display: grid;
    grid-template-columns: 7em minmax(0, 1fr);
    gap: var(--s-4);
    padding-bottom: var(--s-3);
    border-bottom: 1px dashed rgb(58 29 63 / 0.25);
  }
  .iconset {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-4);
  }
  .iconset li {
    display: grid;
    gap: var(--s-4);
    justify-items: start;
    padding: var(--s-6) var(--s-4) var(--s-4);
    border-radius: var(--r-md);
    background: var(--paper-bg);
    font-size: var(--fs-xs);
    font-weight: 600;
  }

  /* 08 ---------------------------------------------------------------- */
  .patterns {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-4);
  }
  .patterns figure {
    margin: 0;
    display: grid;
    gap: var(--s-2);
    align-content: start;
  }
  .patterns__big {
    grid-column: 1 / -1;
  }
  .patterns__tile {
    height: 200px;
    border-radius: var(--r-md);
    overflow: hidden;
  }
  .patterns__big .patterns__tile {
    height: 300px;
    outline: 1px solid rgb(58 29 63 / 0.16);
    outline-offset: -1px;
  }
  .patterns figcaption {
    display: grid;
    font-size: var(--fs-xs);
    line-height: 1.4;
    color: rgb(58 29 63 / 0.78);
  }
  .patterns figcaption b {
    color: var(--c-ciruela);
    font-size: var(--fs-sm);
  }

  /* 09 ---------------------------------------------------------------- */
  .traits {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }
  .traits li {
    padding: 6px 16px;
    border-radius: var(--r-pill);
    box-shadow: inset 0 0 0 1.5px var(--c-ciruela);
    font-family: var(--f-display);
    font-weight: 700;
    font-size: var(--fs-sm);
  }
  .taglines {
    padding: var(--s-8);
    border-radius: var(--r-md);
    background: var(--c-ciruela);
    color: var(--c-crema);
    display: grid;
    gap: var(--s-3);
  }
  .taglines__main {
    margin: 0;
    font-family: var(--f-display);
    font-weight: 800;
    font-size: var(--fs-2xl);
    line-height: 0.98;
    letter-spacing: -0.04em;
    max-width: 14ch;
  }
  .taglines__sub {
    margin: 0;
    font-size: var(--fs-lg);
    color: var(--c-lima);
    font-family: var(--f-display);
    font-weight: 500;
  }
  .voice ul {
    list-style: none;
    margin: var(--s-4) 0 0;
    padding: 0;
    display: grid;
    gap: var(--s-3);
    font-size: var(--fs-sm);
    line-height: 1.45;
  }
  .voice li {
    position: relative;
    padding-left: 1.6em;
  }
  .voice li::before {
    position: absolute;
    left: 0;
    top: 0.1em;
    font-weight: 800;
  }
  .voice--si li::before {
    content: '+';
  }
  .voice--no li::before {
    content: '–';
    opacity: 0.6;
  }
  .voice--no li {
