---
import ShopLayout from '../../layouts/ShopLayout.astro';
import HeroBox from '../../components/site/HeroBox.astro';
import CategoryCard from '../../components/site/CategoryCard.astro';
import { categories, minOrderUnits } from '../../data/categories';
import { taglines } from '../../data/brand';

const minUnits = minOrderUnits;

// Small checks under the hero buttons: what every box is, never a promise.
const ticks = ['Cartón corrugado reciclable', 'Medidas estándar de EE. UU.', 'Guía de armado incluida'] as const;

// Neutral proof row at the foot of the hero panel (no client logos, no numbers we can't back).
const proofs = [
  { icon: 'stack', label: `Desde ${minUnits} cajas` },
  { icon: 'stamp', label: 'Con tu logo' },
  { icon: 'pin', label: 'Envíos en EE. UU.' },
  { icon: 'chat', label: 'Atención personalizada' },
] as const;

const starters = [
  { title: 'A tu medida', text: '¿Tu producto no cabe en una caja estándar? La hacemos para él.' },
  { title: 'Fáciles de armar', text: 'Pliegues marcados y una guía paso a paso.' },
  { title: 'Cartón reciclable', text: 'Se recicla con el resto del papel, sin plásticos.' },
] as const;

const steps = [
  { title: 'Elige tu caja', text: 'Explora las 12 familias y escoge la medida que le queda a tu producto.' },
  { title: 'Ponle tu marca', text: 'Sube tu logo y mira cómo se ve en la caja antes de pedirla.' },
  { title: 'Recíbela en tu puerta', text: 'Te llega lista para empacar, con la guía de armado incluida.' },
];
---

<ShopLayout title="Foldwise · Tienda de cajas para emprendedores">
  <section class="hero" aria-labelledby="hero-title" data-hero-panel>
    <div class="hero__copy">
      <h1 id="hero-title" class="hero__title">{taglines.principal}</h1>
      <p class="hero__lede">
        Cajas de cartón corrugado para tu tienda en línea, con tu logo y en la medida justa, desde {minUnits} unidades.
        {taglines.secundaria}
      </p>
      <div class="hero__actions">
        <a href="#categorias" class="btn btn--lime">Explora las cajas</a>
        <a href="/tienda/producto/cajas-mailer" class="btn btn--ghost">Personaliza tu mailer</a>
      </div>
      <ul class="hero__ticks">
        {
          ticks.map((t) => (
            <li>
              <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                <circle cx="8" cy="8" r="7" />
                <path d="M4.8 8.3l2.2 2.2 4.2-4.8" />
              </svg>
              {t}
            </li>
          ))
        }
      </ul>
    </div>

    <figure class="hero__media">
      <img
        class="hero__photo"
        src="/img/products/hero.webp"
        alt="Caja mailer Foldwise color ciruela abierta, con el logo impreso al frente; adentro, papel de seda, una tarjeta en blanco y un frasco de vidrio ámbar"
        width="1600"
        height="1200"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        data-hero-photo
      />
    </figure>

    <ul class="hero__proof" aria-label="Lo que tienes con Foldwise">
      {
        proofs.map((p) => (
          <li>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              {p.icon === 'stack' && (
                <>
                  <path d="M4 15.5l8 4 8-4" />
                  <path d="M4 11.5l8 4 8-4" />
                  <path d="M12 3.5l8 4-8 4-8-4z" />
                </>
              )}
              {p.icon === 'stamp' && (
                <>
                  <rect x="3.5" y="5" width="17" height="14" rx="2" />
                  <path d="M8 15.5V9h3.2M8 12h2.6" />
                  <path d="M14 15.5h2.5" />
                </>
              )}
              {p.icon === 'pin' && (
                <>
                  <path d="M12 21s-6.5-6.2-6.5-11a6.5 6.5 0 0 1 13 0c0 4.8-6.5 11-6.5 11z" />
                  <circle cx="12" cy="10" r="2.3" />
                </>
              )}
              {p.icon === 'chat' && (
                <path d="M5 5.5h14a1.5 1.5 0 0 1 1.5 1.5v8a1.5 1.5 0 0 1-1.5 1.5H10l-4.5 3.5V16.5H5A1.5 1.5 0 0 1 3.5 15V7A1.5 1.5 0 0 1 5 5.5z" />
              )}
            </svg>
            {p.label}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="unbox" aria-labelledby="unbox-title">
    <div class="unbox__stage" data-hero-scope>
      <div class="unbox__box">
        <HeroBox />
      </div>
      <div class="unbox__caption">
        <span data-hero-hint>Toca la caja para abrirla</span>
        <span class="unbox__spec">Caja mailer M-1410, 14 × 10 × 4 in</span>
      </div>
    </div>
    <div class="unbox__copy">
      <h2 id="unbox-title">Ábrela como la abre tu cliente</h2>
      <p>
        La tapa se levanta y lo primero que ve es lo que tú pusiste adentro. Así se siente recibir una caja mailer con tu
        marca.
      </p>
      <div class="unbox__links">
        <a href="/tienda/producto/cajas-mailer" class="btn btn--ghost">Ponle tu logo</a>
        <a href="/tienda/guia/cajas-mailer" class="unbox__guide">Mira cómo se arma</a>
      </div>
    </div>
  </section>

  <section id="categorias" class="cats" aria-labelledby="cats-title">
    <div class="section-head">
      <div>
        <h2 id="cats-title">Encuentra tu caja</h2>
        <p>12 familias de cajas de cartón corrugado, en medidas estándar de EE. UU.</p>
      </div>
      <a href="/tienda/catalogo" class="btn btn--ghost">Ver el catálogo completo</a>
    </div>
    <div class="cats__grid">
      {categories.map((c) => <CategoryCard category={c} />)}
    </div>
  </section>

  <section class="starters" aria-labelledby="starters-title">
    <div class="starters__panel">
      <div class="starters__copy">
        <h2 id="starters-title">Hecho para los que están arrancando</h2>
        <p class="starters__lede">
          Nadie empieza con mil pedidos. Por eso pides las cajas que necesitas hoy, combinas medidas y hablas con alguien
          que te explica todo en simple. Ser pequeño no te hace cliente secundario.
        </p>
        <ul class="starters__list">
          {
            starters.map((s) => (
              <li>
                <strong>{s.title}</strong>
                <span>{s.text}</span>
              </li>
            ))
          }
        </ul>
        <a href="/tienda/catalogo" class="btn btn--lime">Arma tu primer pedido</a>
      </div>
      <figure class="starters__photos">
        <img
          class="starters__photo starters__photo--main"
          src="/img/shop-emprendedora.jpg"
          alt="Emprendedora preparando pedidos de su tienda en línea entre cajas de cartón"
          width="1600"
          height="1068"
          loading="lazy"
          decoding="async"
        />
        <img
          class="starters__photo starters__photo--side"
          src="/img/shop-etiquetando.jpg"
          alt="Dos emprendedoras escriben los datos de envío sobre cajas kraft"
          width="1600"
          height="1068"
          loading="lazy"
          decoding="async"
        />
        <figcaption class="starters__note">
          <span class="starters__note-num">{minUnits}</span>
          <span>cajas es todo lo que necesitas para empezar</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="family" aria-labelledby="family-title">
    <div class="section-head">
      <div>
        <h2 id="family-title">Toda la familia</h2>
        <p>Del mailer para joyería a la caja de mudanza, las 12 familias juntas.</p>
      </div>
      <a href="/tienda/catalogo" class="btn btn--ghost">Compara las medidas</a>
    </div>
    <img
      class="family__photo"
      src="/img/products/familia.webp"
      alt="Las 12 cajas de Foldwise juntas: cajas de mudanza, reforzadas y de envío con cinta lima, una caja de vino ciruela, mailers, una caja de regalo ciruela y una caja de ropa crema"
      width="2000"
      height="1000"
      loading="lazy"
      decoding="async"
      data-family-photo
    />
  </section>

  <section class="steps" aria-labelledby="steps-title">
    <img
      class="steps__photo"
      src="/img/shop-empacando.jpg"
      alt="Dos emprendedoras empacan productos con relleno de papel en cajas de cartón"
      width="1600"
      height="1068"
      loading="lazy"
      decoding="async"
      data-reveal
    />
    <div class="steps__copy">
      <h2 id="steps-title">Tu primera caja, en tres pasos</h2>
      <ol class="steps__list">
        {
          steps.map((s, i) => (
            <li data-reveal>
              <span class="steps__num" aria-hidden="true">{i + 1}</span>
              <span>
                <strong>{s.title}</strong>
                {s.text}
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</ShopLayout>

<style>
  .hero,
  .unbox,
  .cats,
  .starters,
  .family,
  .steps {
    max-width: 1360px;
    margin-inline: auto;
    padding-inline: var(--s-8);
  }

  /* ───── buttons ───── */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-2);
    min-height: 50px;
    padding: 0 1.5rem;
    border-radius: var(--r-pill);
    font-weight: 600;
    font-size: var(--fs-sm);
    text-decoration: none;
    white-space: nowrap;
    transition:
      transform 0.15s cubic-bezier(0.2, 0.8, 0.2, 1),
      background 0.2s,
      box-shadow 0.2s,
      color 0.2s;
  }
  .btn:active {
    transform: translateY(1px) scale(0.97);
  }
  .btn--lime {
    background: var(--c-lima);
    color: var(--c-ciruela);
    box-shadow: inset 0 -2px 0 rgba(42, 20, 48, 0.18);
  }
  .btn--lime:hover {
    box-shadow:
      inset 0 -2px 0 rgba(42, 20, 48, 0.18),
      0 10px 24px -12px rgba(110, 150, 20, 0.8);
    transform: translateY(-1px);
  }
  .btn--ghost {
    color: var(--c-ciruela);
    border: 1.5px solid color-mix(in srgb, var(--c-ciruela) 30%, transparent);
  }
  .btn--ghost:hover {
    border-color: var(--c-ciruela);
    background: color-mix(in srgb, var(--c-kraft-claro) 30%, transparent);
  }

  /* ───── hero: one tinted panel, copy left, photo right, proof row at its foot ───── */
  .hero {
    --hero-bg: #f1e6d8;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    grid-template-rows: 1fr auto;
    width: min(calc(100% - 2 * var(--s-8)), calc(1360px - 2 * var(--s-8)));
    max-width: none;
    margin-top: var(--s-6);
    padding: 0;
    border-radius: 28px;
    background: var(--hero-bg);
    overflow: hidden;
    isolation: isolate;
  }
  .hero__copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--s-12) var(--s-8) var(--s-6) var(--s-16);
  }
  .hero__title {
    font-size: clamp(2.6rem, 1.2rem + 3.2vw, 4.1rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
    max-width: 13ch;
    text-wrap: balance;
  }
  .hero__lede {
    margin: var(--s-6) 0 0;
    max-width: 42ch;
    font-size: 1.15rem;
    line-height: 1.5;
    color: color-mix(in srgb, var(--c-ciruela) 82%, var(--hero-bg));
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-8);
  }
  .hero__ticks {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-6);
    margin: var(--s-6) 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--fs-xs);
    font-weight: 600;
    color: color-mix(in srgb, var(--c-ciruela) 80%, var(--hero-bg));
  }
  .hero__ticks li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .hero__ticks svg {
    width: 16px;
    height: 16px;
    flex: none;
    fill: none;
    stroke: var(--c-ciruela);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .hero__media {
    grid-column: 2;
    grid-row: 1 / span 2;
    position: relative;
    margin: 0;
    min-height: 520px;
  }
  .hero__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% 50%;
    /* melt the photo's own backdrop into the panel instead of showing a seam */
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 16%);
    mask-image: linear-gradient(90deg, transparent 0, #000 16%);
  }
  .hero__proof {
    grid-column: 1;
    grid-row: 2;
    display: grid;
    grid-template-columns: repeat(2, max-content);
    gap: var(--s-3) var(--s-12);
    margin: 0 var(--s-8) 0 var(--s-16);
    padding: var(--s-6) 0 var(--s-8);
    list-style: none;
    border-top: 1px dashed color-mix(in srgb, var(--c-kraft-sombra) 55%, transparent);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--c-ciruela);
  }
  .hero__proof li {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    white-space: nowrap;
  }
  .hero__proof svg {
    width: 20px;
    height: 20px;
    flex: none;
    fill: none;
    stroke: var(--c-ciruela);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ───── unboxing: the interactive mailer ───── */
  .unbox {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: var(--s-16);
    align-items: center;
    margin-top: var(--s-24);
  }
  .unbox__stage {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 540px;
    padding: var(--s-4) var(--s-4) var(--s-6);
    border-radius: var(--r-lg);
    /* the paper colour at the photos' edges, so the feathered photo has no seam */
    background: #e1c6a5;
    overflow: hidden;
    isolation: isolate;
  }
  .unbox__box {
    width: min(100%, 640px);
    margin-inline: auto;
  }
  .unbox__caption {
    display: flex;
    justify-content: space-between;
    gap: var(--s-4);
    padding-inline: var(--s-4);
    margin-top: var(--s-4);
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--c-ciruela-claro);
  }
  .unbox__spec {
    font-weight: 500;
    color: color-mix(in srgb, var(--c-ciruela) 65%, var(--c-kraft-claro));
  }
  .unbox__copy h2 {
    font-size: var(--fs-2xl);
    max-width: 12ch;
    text-wrap: balance;
  }
  .unbox__copy p {
    margin: var(--s-6) 0 0;
    max-width: 40ch;
    font-size: var(--fs-lg);
    line-height: 1.5;
    color: color-mix(in srgb, var(--c-ciruela) 78%, var(--c-crema));
  }
  .unbox__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-6);
    margin-top: var(--s-8);
  }
  .unbox__guide {
    font-size: var(--fs-sm);
    font-weight: 600;
    text-decoration-color: var(--c-lima);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .unbox__guide:hover {
    text-decoration-color: var(--c-ciruela);
  }

  /* ───── categories ───── */
  .cats {
    margin-top: var(--s-24);
    scroll-margin-top: 140px;
  }
  .section-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--s-6);
    margin-bottom: var(--s-8);
  }
  .section-head h2 {
    font-size: var(--fs-2xl);
  }
  .section-head p {
    margin: var(--s-3) 0 0;
    color: color-mix(in srgb, var(--c-ciruela) 75%, var(--c-crema));
  }
  .cats__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-6);
  }

  /* ───── family lineup ───── */
  .family {
    margin-top: var(--s-24);
  }
  .family__photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 1;
    object-fit: cover;
    border-radius: var(--r-lg);
    background: #f1e7dd;
  }

  /* ───── starters ───── */
  .starters {
    margin-top: var(--s-24);
  }
  .starters__panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: var(--s-12);
    align-items: center;
    padding: var(--s-16);
    border-radius: var(--r-lg);
    background: var(--c-ciruela);
    color: var(--c-crema);
    overflow: hidden;
  }
  .starters__copy h2 {
    font-size: var(--fs-2xl);
    max-width: 12ch;
    color: var(--c-crema);
  }
  .starters__lede {
    margin: var(--s-6) 0 var(--s-8);
    max-width: 46ch;
    color: color-mix(in srgb, var(--c-crema) 82%, transparent);
  }
  .starters__list {
    margin: 0 0 var(--s-8);
    padding: 0;
    list-style: none;
    border-top: 1px dashed color-mix(in srgb, var(--c-crema) 28%, transparent);
  }
  .starters__list li {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    gap: var(--s-4);
    align-items: baseline;
    padding: var(--s-3) 0;
    border-bottom: 1px dashed color-mix(in srgb, var(--c-crema) 28%, transparent);
    font-size: var(--fs-sm);
    color: color-mix(in srgb, var(--c-crema) 78%, transparent);
  }
  .starters__list strong {
    color: var(--c-lima);
    font-family: var(--f-display);
    font-size: 1rem;
    letter-spacing: -0.02em;
  }
  .starters__photos {
    position: relative;
    margin: 0;
    min-height: 460px;
  }
  .starters__photo {
    position: absolute;
    object-fit: cover;
    border-radius: var(--r-md);
  }
  .starters__photo--main {
    top: 0;
    right: 0;
    width: 82%;
    height: 78%;
  }
  .starters__photo--side {
    left: 0;
    bottom: 0;
    width: 50%;
    height: 46%;
    border: 6px solid var(--c-ciruela);
  }
  .starters__note {
    position: absolute;
    right: 4%;
    bottom: 4%;
    display: flex;
    align-items: center;
    gap: var(--s-3);
    max-width: 230px;
    padding: var(--s-3) var(--s-4);
    border-radius: var(--r-sm);
    transform: rotate(-2.5deg);
    background: var(--c-crema);
    color: var(--c-ciruela);
    font-size: var(--fs-xs);
    font-weight: 600;
    line-height: 1.3;
    box-shadow: 0 20px 40px -20px rgba(0, 0, 0, 0.5);
  }
  .starters__note-num {
    font-family: var(--f-display);
    font-weight: 800;
    font-size: 2.2rem;
    letter-spacing: -0.04em;
    line-height: 1;
    padding-bottom: 2px;
    border-bottom: 3px dashed var(--c-lima);
  }

  /* ───── steps ───── */
  .steps {
    margin-top: var(--s-24);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--s-16);
    align-items: center;
  }
  .steps__photo {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--r-lg);
  }
  .steps__copy h2 {
    font-size: var(--fs-2xl);
    max-width: 14ch;
  }
  .steps__list {
    display: grid;
    gap: var(--s-6);
    margin: var(--s-8) 0 0;
    padding: 0;
    list-style: none;
    counter-reset: none;
  }
  .steps__list li {
    display: flex;
    gap: var(--s-6);
    align-items: flex-start;
    padding-bottom: var(--s-6);
    border-bottom: 1px dashed color-mix(in srgb, var(--c-kraft) 70%, transparent);
    color: color-mix(in srgb, var(--c-ciruela) 75%, var(--c-crema));
  }
  .steps__list li:last-child {
    border-bottom: 0;
  }
  .steps__list strong {
    display: block;
    margin-bottom: var(--s-1);
    font-family: var(--f-display);
    font-size: 1.35rem;
    letter-spacing: -0.03em;
    color: var(--c-ciruela);
  }
  .steps__num {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1.5px solid var(--c-ciruela);
    font-family: var(--f-display);
    font-weight: 800;
    font-size: 1.25rem;
    color: var(--c-ciruela);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* ───── responsive ───── */
  @media (max-width: 1100px) {
    .cats__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .starters__panel {
      padding: var(--s-12);
    }
    .hero__copy {
      padding: var(--s-12) var(--s-6) var(--s-6) var(--s-12);
    }
    .hero__proof {
      margin-left: var(--s-12);
    }
  }
  @media (max-width: 900px) {
    .hero,
    .unbox,
    .starters__panel,
    .steps {
      grid-template-columns: minmax(0, 1fr);
    }
