---
/**
 * Isometric Foldwise box. All geometry lives in ./iso-geometry.ts; this file
 * only serialises the fitted parts and places the branding on the front face.
 */
import type { BoxStyle } from '../../data/categories';
import Isotype from '../brand/Isotype.astro';
import { buildBox, pathD, VIEWBOX, COLORWAYS } from './iso-geometry';
import type { Colorway, Branding, Part } from './iso-geometry';

interface Props {
  style: BoxStyle;
  /** Inside dimensions in inches. */
  l: number;
  w: number;
  h: number;
  colorway?: Colorway;
  branding?: Branding;
  open?: boolean;
  /** Image URL placed on the front face when branding is "cliente". */
  clientLogo?: string;
  /** Accessible name; defaults to a Spanish description of the box. */
  label?: string;
  class?: string;
}

const STYLE_NAMES: Record<BoxStyle, string> = {
  rsc: 'Caja de envío',
  mailer: 'Caja mailer',
  easyfold: 'Mailer fácil de armar',
  multidepth: 'Caja multi-altura',
  file: 'Caja de archivo',
  sideloader: 'Caja de carga lateral',
  wine: 'Caja para botellas',
  retail: 'Caja de regalo',
  apparel: 'Caja para ropa',
};
const COLOR_NAMES: Record<Colorway, string> = { kraft: 'kraft', ciruela: 'ciruela', crema: 'crema', blanco: 'blanca' };
type IsotypeVariant = 'crema' | 'ciruela' | 'kraft' | 'lima';
const ISOTYPE_ON: Record<Colorway, IsotypeVariant> = { kraft: 'kraft', ciruela: 'ciruela', crema: 'crema', blanco: 'crema' };

const {
  style,
  l,
  w,
  h,
  colorway = 'kraft',
  branding = 'none',
  open = false,
  clientLogo,
  label,
  class: className,
} = Astro.props;

const scene = buildBox({ style, l, w, h, open, colorway, branding });
const pal = COLORWAYS[colorway];
// Deterministic ids: derived from the props plus a per-render counter, so
// builds are stable and identical boxes on one page never collide.
const locals = Astro.locals as Record<string, unknown>;
const seq = ((locals.__isoBoxSeq as number | undefined) ?? 0) + 1;
locals.__isoBoxSeq = seq;
const slug = `${style}-${l}-${w}-${h}-${colorway}-${open ? 'o' : 'c'}-${branding}`.replace(/[^a-z0-9-]/gi, '_');
const uid = `ib-${slug}-${seq}`;
const ref = (name: string) => `url(#${uid}-${name})`;
const paint = (v?: string) => (v?.startsWith('url:') ? ref(v.slice(4)) : (v ?? 'none'));
const fmt = (n: number) => (Number.isInteger(n) ? `${n}` : `${n}`.replace('.', ','));
const name =
  label ??
  `${STYLE_NAMES[style]} ${COLOR_NAMES[colorway]} de ${fmt(l)} × ${fmt(w)} × ${fmt(h)} pulgadas${open ? ', abierta' : ''}`;

function attrs(p: Part) {
  return {
    d: pathD(p),
    fill: p.closed ? paint(p.fill) : 'none',
    stroke: p.stroke ? paint(p.stroke) : undefined,
    'stroke-width': p.stroke ? (p.sw ?? 1) : undefined,
    'stroke-dasharray': p.dash,
    'stroke-linejoin': 'round',
    'stroke-linecap': p.closed ? undefined : 'round',
    opacity: p.opacity,
    filter: p.filter ? ref(p.filter) : undefined,
    'clip-path': p.clip ? ref(`clip-${p.clip}`) : undefined,
    'fill-rule': p.evenodd ? 'evenodd' : undefined,
    'data-part': p.part,
  };
}

// Branding layout inside the front-face frame (face-local inches).
const logo = scene.logo;
let lockup: { s: number; x: number; y: number; fs: number; tx: number } | null = null;
if (logo && branding === 'foldwise') {
  const s = Math.min(logo.height * 0.62, logo.width / 4.4);
  const fs = s * 0.74;
  const total = s * 1.22 + fs * 3.75;
  const x = (logo.width - total) / 2;
  lockup = { s, x, y: (logo.height - s) / 2, fs, tx: x + s * 1.22 };
}
const ph = logo
  ? (() => {
      const pw = Math.min(logo.width * 0.8, logo.height * 2.6);
      const phh = Math.min(logo.height * 0.7, pw * 0.42);
      return { x: (logo.width - pw) / 2, y: (logo.height - phh) / 2, w: pw, h: phh };
    })()
  : null;
---

<svg
  class:list={['iso-box', className]}
  viewBox={`0 0 ${VIEWBOX.w} ${VIEWBOX.h}`}
  role="img"
  aria-label={name}
  data-style={style}
  data-open={open ? 'true' : 'false'}
  data-colorway={colorway}
  data-branding={branding}
  data-client-logo={branding === 'cliente' && clientLogo ? '' : undefined}
  focusable="false"
>
  <defs>
    <filter id={`${uid}-blur`} x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="5"></feGaussianBlur>
    </filter>
    <linearGradient id={`${uid}-vshade`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FFFFFF" stop-opacity="0.06"></stop>
      <stop offset="0.55" stop-color="#000000" stop-opacity="0"></stop>
      <stop offset="1" stop-color="#2A1430" stop-opacity="0.13"></stop>
    </linearGradient>
    <linearGradient id={`${uid}-deep`} x1="1" y1="0" x2="0" y2="0.4">
      <stop offset="0" stop-color="#000000" stop-opacity="0.05"></stop>
      <stop offset="1" stop-color="#000000" stop-opacity="0.45"></stop>
    </linearGradient>
    <pattern id={`${uid}-grain`} width="23" height="19" patternUnits="userSpaceOnUse">
      <circle cx="3" cy="4" r="0.55" fill="#6E4F31" opacity="0.22"></circle>
      <circle cx="14" cy="2" r="0.4" fill="#FFF6E6" opacity="0.3"></circle>
      <circle cx="19" cy="11" r="0.6" fill="#6E4F31" opacity="0.18"></circle>
      <circle cx="8" cy="14" r="0.45" fill="#FFF6E6" opacity="0.25"></circle>
      <circle cx="11" cy="8" r="0.35" fill="#6E4F31" opacity="0.25"></circle>
      <path d="M2 10l4 1.2 M15 16l5-1" stroke="#7A5A3A" stroke-width="0.4" opacity="0.18"></path>
    </pattern>
    {
      scene.clips.map((cl) => (
        <clipPath id={`${uid}-clip-${cl.name}`}>
          <path d={pathD({ pts: [cl.pts], closed: true })} />
        </clipPath>
      ))
    }
  </defs>

  {scene.parts.map((p) => <path {...attrs(p)} />)}

  {
    logo && (
      <g transform={`matrix(${logo.matrix.join(' ')})`} data-part="front-print">
        {lockup && (
          <g data-part="brand">
            <g transform={`translate(${lockup.x} ${lockup.y})`}>
              <Isotype variant={ISOTYPE_ON[colorway]} size={lockup.s} label="" />
            </g>
            <text
              x={lockup.tx}
              y={lockup.y + lockup.s * 0.8}
              font-family="'Bricolage Grotesque', sans-serif"
              font-weight="800"
              font-size={lockup.fs}
              letter-spacing="-0.035em"
              fill={pal.ink}
            >
              foldwise
            </text>
          </g>
        )}
        {branding === 'cliente' && clientLogo && ph && (
          <image
            href={clientLogo}
            x={ph.x}
            y={ph.y}
            width={ph.w}
            height={ph.h}
            preserveAspectRatio="xMidYMid meet"
            data-part="client-logo"
          />
        )}
        {branding === 'cliente' && !clientLogo && ph && (
          <g data-part="logo-placeholder">
            <rect
              x={ph.x}
              y={ph.y}
              width={ph.w}
              height={ph.h}
              rx={ph.h * 0.22}
              fill="none"
              stroke={pal.ink}
              stroke-width={ph.h * 0.035}
              stroke-dasharray={`${ph.h * 0.1} ${ph.h * 0.07}`}
              opacity="0.7"
            />
            <text
              x={ph.x + ph.w / 2}
              y={ph.y + ph.h / 2}
              text-anchor="middle"
              dominant-baseline="central"
              font-family="'Figtree', sans-serif"
              font-weight="600"
              font-size={Math.min(ph.h * 0.3, ph.w / 7.5)}
              fill={pal.ink}
              opacity="0.8"
            >
              Tu logo aquí
            </text>
          </g>
        )}
      </g>
    )
  }
</svg>

<style>
  .iso-box {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
</style>
