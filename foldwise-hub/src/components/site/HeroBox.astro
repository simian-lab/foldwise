---
/**
 * Interactive mailer photo. Three aligned photos of the same box (closed,
 * lid lifted, open) are stacked; toggling crossfades through them with a
 * short stagger (see src/scripts/hero-box.ts). The server sends the closed
 * box; under reduced motion the inline script shows the open one before
 * first paint.
 */
const FRAMES = [
  {
    key: 'closed',
    src: '/img/products/mailer-cerrada.webp',
    alt: 'Caja mailer Foldwise color ciruela, cerrada, con el logo de Foldwise impreso en la tapa.',
  },
  {
    key: 'half',
    src: '/img/products/mailer-entreabierta.webp',
    alt: 'La misma caja mailer con la tapa levantada a medias; asoma el papel de seda blanco.',
  },
  {
    key: 'open',
    src: '/img/products/mailer-abierta.webp',
    alt: 'La caja mailer abierta: interior kraft con papel de seda, una tarjeta que dice «¡Gracias por apoyar lo pequeño!» y un frasco de vidrio; en la tapa, «Lo pequeño se cuida en grande.».',
  },
] as const;
---

<button
  type="button"
  class="hero-box"
  data-hero-box
  data-open="false"
  data-progress="0"
  data-motion="pending"
  aria-pressed="false"
  aria-label="Abrir o cerrar la caja"
  aria-describedby="hero-box-desc"
>
  <span id="hero-box-desc" class="visually-hidden">
    Caja mailer Foldwise color ciruela que se abre y muestra papel de seda, una tarjeta de agradecimiento y un frasco.
  </span>
  <span class="hero-box__frames">
    {
      FRAMES.map((f, i) => (
        <img
          data-frame={f.key}
          src={f.src}
          alt={f.alt}
          width="1400"
          height="1120"
          decoding="async"
          loading={i === 0 ? 'eager' : 'lazy'}
          aria-hidden={i === 0 ? undefined : 'true'}
          draggable="false"
        />
      ))
    }
  </span>
</button>
<script is:inline>
  // Reduced motion: show the open photo now, before first paint. The module
  // script then mounts on an already-open box and keeps it in sync.
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const root = document.currentScript && document.currentScript.previousElementSibling;
    if (root && root.matches('[data-hero-box]')) {
      root.querySelectorAll('img[data-frame]').forEach((img) => {
        const on = img.getAttribute('data-frame') === 'open';
        if (on) {
          img.removeAttribute('aria-hidden');
          img.setAttribute('loading', 'eager');
        } else img.setAttribute('aria-hidden', 'true');
      });
      root.setAttribute('data-open', 'true');
      root.setAttribute('data-progress', '1');
      root.setAttribute('aria-pressed', 'true');
    }
  }
</script>

<script>
  import { mountHeroBox } from '../../scripts/hero-box';
  document.querySelectorAll<HTMLElement>('[data-hero-box]').forEach(mountHeroBox);
</script>

<style>
  .hero-box {
    all: unset;
    display: block;
    width: 100%;
    cursor: pointer;
    border-radius: var(--r-lg);
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
  .hero-box:active {
    transform: scale(0.99);
  }
  .hero-box:focus-visible {
    outline: 2px solid var(--c-ciruela);
    outline-offset: 6px;
  }

  /* The three photos share one grid cell. Each later frame covers the earlier
     ones, so opening only fades frames in (half, then open) and closing fades
     them out in reverse: no frame ever shows the backdrop through two boxes. */
  .hero-box__frames {
    display: grid;
    aspect-ratio: 1400 / 1120;
    /* the photo's paper backdrop melts into the stage colour: every edge fades to zero */
    --hb-fade-x: linear-gradient(to right, transparent, #000 12%, #000 88%, transparent);
    --hb-fade-y: linear-gradient(to bottom, transparent, #000 10%, #000 88%, transparent);
    mask-image: var(--hb-fade-x), var(--hb-fade-y);
    mask-composite: intersect;
    -webkit-mask-image: var(--hb-fade-x), var(--hb-fade-y);
    -webkit-mask-composite: source-in;
  }
  .hero-box__frames img {
    grid-area: 1 / 1;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    user-select: none;
    -webkit-user-select: none;
  }
  .hero-box__frames [data-frame='closed'],
  .hero-box[data-open='true'] [data-frame='half'],
  .hero-box[data-open='true'] [data-frame='open'] {
    opacity: 1;
  }

  /* Motion only once the script has mounted and motion is allowed. */
  .hero-box[data-motion='animated'] img {
    transition: opacity 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .hero-box[data-motion='animated'][data-open='true'] [data-frame='half'] {
    transition-duration: 0.26s;
  }
  .hero-box[data-motion='animated'][data-open='true'] [data-frame='open'] {
    transition-duration: 0.42s;
    transition-delay: 0.22s;
  }
  .hero-box[data-motion='animated'][data-open='false'] [data-frame='open'] {
    transition-duration: 0.32s;
  }
  .hero-box[data-motion='animated'][data-open='false'] [data-frame='half'] {
    transition-duration: 0.38s;
    transition-delay: 0.2s;
  }
  /* A closed box hints at the lid when pointed at. */
  @media (hover: hover) {
    .hero-box[data-motion='animated'][data-open='false']:hover [data-frame='half'] {
      opacity: 0.3;
      transition-delay: 0s;
    }
  }

  /* A tiny lift while the lid moves, then the box settles. Two identical
     keyframes so the animation restarts on every toggle. */
  .hero-box[data-moved][data-open='true'] .hero-box__frames {
    animation: hb-lift-a 0.68s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .hero-box[data-moved][data-open='false'] .hero-box__frames {
    animation: hb-lift-b 0.68s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  @keyframes hb-lift-a {
    0% { transform: none; }
    38% { transform: translateY(-1.4%) scale(1.012); }
    100% { transform: none; }
  }
  @keyframes hb-lift-b {
    0% { transform: none; }
    38% { transform: translateY(-1.4%) scale(1.012); }
    100% { transform: none; }
  }
</style>
