---
/**
 * One explored palette direction, rebuilt from the brainstorm sketch: the
 * wordmark in the main colour, the four swatches, a kraft box wearing the
 * palette's band, and the two button styles.
 */
interface Swatch {
  name: string;
  hex: string;
}

interface Props {
  /** Value for data-direction, e.g. "palette-a". */
  id: string;
  letter: string;
  name: string;
  /** Cream, kraft, main, accent, in that order. */
  colors: [Swatch, Swatch, Swatch, Swatch];
  /** Band colour on the box and the ink of its text. */
  band: string;
  bandInk: string;
  /** Ink for the accent button. */
  accentInk: string;
  note: string;
  chosen?: boolean;
}

const { id, letter, name, colors, band, bandInk, accentInk, note, chosen = false } = Astro.props;
const [, , main, accent] = colors;
const light = (hex: string) => {
  const n = parseInt(hex.slice(1), 16);
  return 0.2126 * ((n >> 16) & 255) + 0.7152 * ((n >> 8) & 255) + 0.0722 * (n & 255) > 150;
};
---

<figure class:list={['study', { 'study--chosen': chosen }]} data-direction={id}>
  <div class="study__card" style={`--main:${main.hex}`}>
    <p class="study__wm" style={`color:${main.hex}`} aria-hidden="true">foldwise</p>
    <ul class="study__swatches" role="list">
      {
        colors.map((c) => (
          <li style={`background:${c.hex};color:${light(c.hex) ? '#2A2A2A' : '#FFFFFF'}`}>
            <span>{c.name}</span>
          </li>
        ))
      }
    </ul>
    <svg class="study__box" viewBox="0 0 200 132" role="img" aria-label={`Caja kraft con la banda de la paleta ${name}`}>
      <ellipse cx="100" cy="120" rx="74" ry="8" fill="#3A1D3F" opacity="0.1"></ellipse>
      <path d="M30 46L110 26L170 46L90 66Z" fill="#E2C7A0"></path>
      <path d="M30 46L90 66V116L30 96Z" fill="#C9A27A"></path>
      <path d="M90 66L170 46V96L90 116Z" fill="#A9845E"></path>
      <g transform="matrix(1 0.3333 0 1 30 46)">
        <rect x="0" y="17" width="60" height="15" fill={band}></rect>
        <text
          x="30"
          y="28"
          text-anchor="middle"
          font-family="Bricolage Grotesque, sans-serif"
          font-weight="800"
          font-size="10"
          letter-spacing="-0.3"
          fill={bandInk}>foldwise</text
        >
      </g>
      <g transform="matrix(1 -0.25 0 1 90 66)">
        <rect x="0" y="17" width="80" height="15" fill={band}></rect>
      </g>
    </svg>
    <div class="study__buttons" aria-hidden="true">
      <span style={`background:${main.hex};color:#FFFFFF`}>Ver cajas</span>
      <span style={`background:${accent.hex};color:${accentInk}`}>Personaliza</span>
    </div>
  </div>
  <figcaption>
    <b><span class="study__letter">{letter}</span>{name}</b>
    {chosen && <span class="study__badge">Elegida</span>}
    <span class="study__note">{note}</span>
  </figcaption>
</figure>

<style>
  .study {
    margin: 0;
    display: grid;
    gap: var(--s-3);
    align-content: start;
    min-width: 0;
  }
  .study__card {
    background: #f6f1e7;
    border-radius: var(--r-md);
    padding: var(--s-4);
    box-shadow: inset 0 0 0 1px rgb(58 29 63 / 0.12);
    display: grid;
    gap: var(--s-3);
  }
  .study--chosen .study__card {
    box-shadow: inset 0 0 0 2px var(--c-ciruela);
  }
  .study__wm {
    margin: 0;
    font-family: var(--f-display);
    font-weight: 800;
    font-size: 1.6rem;
    letter-spacing: -0.035em;
    line-height: 1;
  }
  .study__swatches {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 4px;
  }
  .study__swatches li {
    height: 36px;
    border-radius: 6px;
    display: flex;
    align-items: flex-end;
    padding: 3px 5px;
    font-size: 0.625rem;
    font-weight: 600;
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.06);
    overflow: hidden;
  }
  .study__box {
    width: 100%;
    height: auto;
    background: #ece4d4;
    border-radius: var(--r-sm);
  }
  .study__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .study__buttons span {
    padding: 6px 12px;
    border-radius: var(--r-pill);
    font-size: 0.75rem;
    font-weight: 700;
  }
  figcaption {
    display: grid;
    gap: 2px;
    font-size: var(--fs-xs);
    line-height: 1.45;
  }
  figcaption b {
    font-family: var(--f-display);
    font-size: var(--fs-sm);
    font-weight: 700;
  }
  figcaption b {
    display: flex;
    align-items: center;
    gap: var(--s-2);
  }
  .study__letter {
    display: inline-grid;
    place-items: center;
    width: 1.5em;
    height: 1.5em;
    border-radius: 50%;
    border: 1.5px solid currentColor;
    font-size: 0.75rem;
  }
  .study__badge {
    justify-self: start;
    background: var(--c-lima);
    color: var(--c-ciruela);
    font-weight: 700;
    padding: 1px 8px;
    border-radius: var(--r-pill);
  }
  .study__note {
    color: rgb(58 29 63 / 0.78);
  }
</style>
