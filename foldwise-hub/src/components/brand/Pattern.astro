---
/**
 * Tileable brand pattern drawn as an SVG <pattern> that fills its box.
 * - troquel: the die-cut sheet: dashed fold lines and solid cut lines with the
 *   isotype's chamfered tuck flaps.
 * - flauta: the corrugated flute: a wave between two liners, row after row.
 */
interface Props {
  kind: 'troquel' | 'flauta';
  /** Line colour. */
  color?: string;
  /** Background colour. */
  bg?: string;
  /** Tile size multiplier. */
  scale?: number;
  /** Accessible name; empty string makes it decorative. */
  label?: string;
  class?: string;
}

const { kind, color = '#3A1D3F', bg = '#F6F1E7', scale = 1, label = '', class: className } = Astro.props;
const id = `pt${Math.random().toString(36).slice(2, 9)}`;
const tile = kind === 'troquel' ? { w: 96, h: 96 } : { w: 40, h: 22 };
const decorative = label === '';
---

<svg
  class:list={['fw-pattern', className]}
  data-pattern={kind}
  width="100%"
  height="100%"
  role={decorative ? undefined : 'img'}
  aria-label={decorative ? undefined : label}
  aria-hidden={decorative ? 'true' : undefined}
  focusable="false"
>
  <defs>
    <pattern
      id={id}
      width={tile.w}
      height={tile.h}
      patternUnits="userSpaceOnUse"
      patternTransform={`scale(${scale})`}
    >
      <rect width={tile.w} height={tile.h} fill={bg}></rect>
      {
        kind === 'troquel' ? (
          <g fill="none" stroke={color} stroke-linecap="round" stroke-linejoin="round">
            {/* fold lines run edge to edge so they continue into the next tile */}
            <path d="M0 48H96 M48 0V96" stroke-width="1.4" stroke-dasharray="4 4" opacity="0.55" />
            {/* tuck flap with chamfered corners, hinged on the fold */}
            <path d="M56 48V30l6-6h20l6 6v18" stroke-width="1.6" />
            <path d="M8 48v18l6 6h20l6-6V48" stroke-width="1.6" />
            {/* thumb notch where a flap is pulled open */}
            <path d="M62 96c0-6 4-9 10-9s10 3 10 9 M62 0c0 6 4 9 10 9s10-3 10-9" stroke-width="1.6" />
            <path d="M14 24h20" stroke-width="1.4" stroke-dasharray="4 4" opacity="0.55" />
          </g>
        ) : (
          <g fill="none" stroke={color} stroke-linecap="butt">
            <path d="M0 1H40 M0 21H40" stroke-width="1.3" />
            <path d="M0 11C5 3 15 3 20 11S35 19 40 11" stroke-width="1.6" />
          </g>
        )
      }
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill={`url(#${id})`}></rect>
</svg>

<style>
  .fw-pattern {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
