---
/**
 * Foldwise animated logo: the true fold ("Pliegue real"). The flat "f" is a
 * die-cut that folds, panel by panel on its dashed creases, into a small
 * closed kraft box, taped and printed with the f, then unfolds back into the
 * f. One piece of board, no fades. Geometry: src/scripts/fold-geometry.ts.
 * Timeline, triggers, small sizes and reduced motion:
 * src/scripts/animated-logo.ts.
 *
 * Contract: root `data-animated-logo`, data-state flat | folding | box
 * (static under reduced motion), trigger load | hover | view, loop only for
 * load; hover and view play once and rest on the flat f.
 *
 * `variant` names the background. The box is kraft with the plum f on both;
 * the flat f is plum on crema and crema on ciruela, as the static isotype.
 * The earlier crossfade version lives on as AnimatedLogoClassic, used only by
 * /marca/logo-animado for comparison.
 */
import { ISOTYPE_PATH, ISOTYPE_FOLDS } from '../../data/brand';
import { PANELS, CREASES, EDGES, TAPE_EDGE, VIEW } from '../../scripts/fold-geometry';
import { FOLD_MATERIALS, PRINT, COMPACT_BELOW, printMatrix } from '../../scripts/animated-logo';

type Variant = 'crema' | 'ciruela';

interface Props {
  size?: number;
  /** Repeat forever (fold, hold, unfold). Applies to trigger="load" only; hover and view play once. */
  loop?: boolean;
  trigger?: 'load' | 'hover' | 'view';
  variant?: Variant;
  class?: string;
}

const { size = 240, loop = true, trigger = 'load', variant = 'crema', class: className } = Astro.props;
const m = FOLD_MATERIALS[variant];
// small logos (the header) drop the detail that cannot read at that size
const compact = size < COMPACT_BELOW;
// the static isotype follows the Isotype component's colours for this background
const staticColors = variant === 'crema' ? { mark: '#3A1D3F', folds: '#C8F25A' } : { mark: '#F6F1E7', folds: '#3A1D3F' };
const uid = `alf-${variant}-${Math.random().toString(36).slice(2, 8)}`;
const poly = (p: [number, number][]) => p.map((q) => q.join(',')).join(' ');

const crease = (i: number) => {
  const c = CREASES[i];
  return c.brand
    ? { w: 0.8, dash: '2.2 2', opacity: 1 }
    : { w: 0.3, dash: '1 1.2', opacity: 0.42 };
};
const creases = CREASES.map((c, i) => ({ c, i })).filter(({ c }) => !compact || c.brand);
---

<div
  data-animated-logo
  data-state="flat"
  data-trigger={trigger}
  data-loop={String(loop)}
  data-variant={variant}
  data-compact={compact ? '' : undefined}
  class:list={['alf', className]}
  style={`--al-size:${size}px`}
  role="img"
  aria-label="Foldwise"
>
  <svg data-al-part class="alf-static" viewBox="0 0 46 46" aria-hidden="true" focusable="false">
    <path data-isotype-shape d={ISOTYPE_PATH} fill={staticColors.mark}></path>
    <path d={ISOTYPE_FOLDS} fill="none" stroke={staticColors.folds} stroke-width="1.6" stroke-dasharray="2.2 2"></path>
  </svg>

  <svg data-al-part class="alf-scene" viewBox={`0 0 ${VIEW} ${VIEW}`} aria-hidden="true" focusable="false">
    <defs>
      {
        !compact && (
          <pattern id={`${uid}-grain`} patternUnits="userSpaceOnUse" width="6" height="6">
            <image class="alf-grain-img" width="6" height="6" preserveAspectRatio="none" />
          </pattern>
        )
      }
      {
        PANELS.map((p) => (
          <linearGradient id={`${uid}-light-${p.id}`} gradientUnits="userSpaceOnUse" x1={p.light[0]} y1={p.light[1]} x2={p.light[2]} y2={p.light[3]}>
            <stop offset="0" stop-color="#FFFFFF" stop-opacity="0.16" />
            <stop offset="0.45" stop-color="#FFFFFF" stop-opacity="0" />
            <stop offset="0.88" stop-color="#2A1430" stop-opacity="0.1" />
            <stop offset="1" stop-color="#2A1430" stop-opacity="0.2" />
          </linearGradient>
        ))
      }
      <linearGradient id={`${uid}-gloss`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0.2" stop-color="#FFFFFF" stop-opacity="0" />
        <stop offset="0.38" stop-color="#FFFFFF" stop-opacity="0.42" />
        <stop offset="0.5" stop-color="#FFFFFF" stop-opacity="0.06" />
        <stop offset="0.72" stop-color="#FFFFFF" stop-opacity="0.22" />
        <stop offset="0.86" stop-color="#FFFFFF" stop-opacity="0" />
      </linearGradient>
      <filter id={`${uid}-blur`} x="-40%" y="-40%" width="180%" height="180%">
        <feGaussianBlur stdDeviation="5" />
      </filter>
      <filter id={`${uid}-blur-s`} x="-30%" y="-30%" width="160%" height="160%">
        <feGaussianBlur stdDeviation="1.6" />
      </filter>
    </defs>

    <g class="alf-shadow">
      <polygon class="alf-shadow-wide" fill={m.shadow} filter={`url(#${uid}-blur)`} style="opacity:0"></polygon>
      <polygon class="alf-shadow-contact" fill={m.shadow} filter={`url(#${uid}-blur-s)`} style="opacity:0"></polygon>
    </g>

    <g class="alf-faces">
      {
        PANELS.map((p) => (
          <g data-face={p.id}>
            <polygon class="alf-base" points={poly(p.poly)} fill={m.inner.top} stroke={m.inner.top} stroke-width="0.6" vector-effect="non-scaling-stroke" stroke-linejoin="round" />
            <g class="alf-in">
              {creases.map(({ c, i }) =>
                c.parent === p.id || c.child === p.id ? (
                  <line
                    data-crease={i}
                    data-half={c.child === p.id ? 'c' : 'p'}
                    stroke={m.creases}
                    data-w={crease(i).w}
                    stroke-width={crease(i).w + 0.14}
                    stroke-dasharray={crease(i).dash}
                    stroke-opacity={crease(i).opacity}
                    style="visibility:hidden"
                  />
                ) : null,
              )}
            </g>
            <g class="alf-out" style="display:none">
              {!compact && <polygon points={poly(p.poly)} fill={`url(#${uid}-grain)`} opacity={m.grain} />}
              {p.id === 'P4' && !compact && (
                <g class="alf-print" style="opacity:0">
                  <g transform={printMatrix()}>
                    <path d={ISOTYPE_PATH} fill={PRINT.ink} shape-rendering="geometricPrecision" />
                    <path d={ISOTYPE_FOLDS} fill="none" stroke={PRINT.folds} stroke-width={PRINT.foldWidth} stroke-dasharray={PRINT.foldDash} />
                  </g>
                </g>
              )}
              <polygon points={poly(p.poly)} fill={`url(#${uid}-light-${p.id})`} />
              {p.id === 'TF' && (
                // the lid's shoulder cut: a shadowed crevice, not a bright gap
                <polygon class="alf-rim" data-rim="0.9" points="31,4 32,4 32,5" fill={m.outer.edge} style="opacity:0" />
              )}
              {p.id === 'P1' && (
                <>
                  <polygon data-tape="top" fill="#C8F25A" stroke="#A6CE3E" stroke-width="0.5" vector-effect="non-scaling-stroke" style="visibility:hidden" />
                  {!compact && <polygon data-tape="top" fill={`url(#${uid}-gloss)`} style="visibility:hidden" />}
                  <polyline class="alf-rim" data-rim="0.4" points="15,4 25,4 25,12" fill="none" stroke={m.rim} stroke-width="0.9" vector-effect="non-scaling-stroke" stroke-linejoin="round" style="opacity:0" />
                </>
              )}
              {p.id === 'P4' && (
                <>
                  <polygon data-tape="front" fill="#B4DA4C" stroke="#97BC36" stroke-width="0.5" vector-effect="non-scaling-stroke" style="visibility:hidden" />
                  {!compact && <polygon data-tape="front" fill={`url(#${uid}-gloss)`} style="visibility:hidden" />}
                  <line class="alf-rim" data-rim="0.18" x1="25" y1="27" x2="25" y2="34" stroke={m.rim} stroke-width="0.8" vector-effect="non-scaling-stroke" style="opacity:0" />
                </>
              )}
            </g>
          </g>
        ))
      }
      {
        EDGES.map((e) => (
          <g data-face={e.id} style="visibility:hidden">
            <polygon class="alf-strip" fill={m.outer.side} stroke={m.outer.edge} stroke-width="0.4" vector-effect="non-scaling-stroke" stroke-linejoin="round" />
            {!compact && <polyline class="alf-flute" fill="none" stroke={m.outer.inner} stroke-width="0.5" vector-effect="non-scaling-stroke" stroke-linejoin="round" />}
            {e.id === TAPE_EDGE && <polygon class="alf-tape-strip" fill="#A9CB46" style="visibility:hidden" />}
          </g>
        ))
      }
    </g>
  </svg>
</div>

<script>
  import { mountAnimatedLogos } from '../../scripts/animated-logo';
  mountAnimatedLogos();
</script>

<style>
  .alf {
    position: relative;
    display: inline-block;
    width: var(--al-size);
    height: var(--al-size);
    max-width: 100%;
    aspect-ratio: 1;
    flex: none;
  }

  .alf-static,
  .alf-scene {
    position: absolute;
    display: block;
    overflow: visible;
  }

  /* The static isotype sits on the same 12 % inset the scene starts from. */
  .alf-static {
    inset: 12%;
    width: 76%;
    height: 76%;
  }

  .alf-scene {
    inset: 0;
    width: 100%;
    height: 100%;
    display: none;
  }

  .alf[data-alf-live] .alf-scene {
    display: block;
  }

  .alf[data-alf-live] .alf-static {
    display: none;
  }
</style>
