---
/**
 * Interface glyphs for the Instagram mockups (not brand icons): drawn on a 24
 * grid, 1.8px stroke, currentColor. Always decorative.
 */
type Name =
  | 'heart'
  | 'comment'
  | 'share'
  | 'save'
  | 'more'
  | 'grid'
  | 'reels'
  | 'tagged'
  | 'home'
  | 'search'
  | 'add'
  | 'profile'
  | 'stack'
  | 'back'
  | 'close'
  | 'swipe';

interface Props {
  name: Name;
  size?: number;
  filled?: boolean;
  class?: string;
}
const { name, size = 22, filled = false, class: className } = Astro.props;
---

<svg
  class:list={['igi', className]}
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'heart' && <path d="M12 20s-7.5-4.6-7.5-10.2A4.3 4.3 0 0 1 12 7.2a4.3 4.3 0 0 1 7.5 2.6C19.5 15.4 12 20 12 20z" fill={filled ? 'currentColor' : 'none'} />}
  {name === 'comment' && <path d="M20.5 11.6a8.4 8.4 0 0 1-12.2 7.5L3.5 20.5l1.4-4.6a8.4 8.4 0 1 1 15.6-4.3z" />}
  {name === 'share' && <path d="M21 3.5 3 10.4l7 2.6 2.6 7zM10 13l5-5" />}
  {name === 'save' && <path d="M6 3.5h12v17l-6-4.4-6 4.4z" />}
  {name === 'more' && (
    <g fill="currentColor" stroke="none">
      <circle cx="5" cy="12" r="1.6" />
      <circle cx="12" cy="12" r="1.6" />
      <circle cx="19" cy="12" r="1.6" />
    </g>
  )}
  {name === 'grid' && <path d="M3.5 3.5h17v17h-17zM9.2 3.5v17M14.8 3.5v17M3.5 9.2h17M3.5 14.8h17" />}
  {name === 'reels' && <path d="M3.5 3.5h17v17h-17zM3.5 8.5h17M8 3.5l3 5M13.5 3.5l3 5M10 12v5l4.5-2.5z" />}
  {name === 'tagged' && <path d="M5 3.5h14v13h-4.5L12 20l-2.5-3.5H5zM12 7.5a2.2 2.2 0 1 1 0 4.4 2.2 2.2 0 0 1 0-4.4zM8 14.5c.8-1.4 2.2-2.1 4-2.1s3.2.7 4 2.1" />}
  {name === 'home' && <path d="M4 10.5 12 4l8 6.5V20h-5.5v-5.5h-5V20H4z" />}
  {name === 'search' && <path d="M10.5 4a6.5 6.5 0 1 1 0 13 6.5 6.5 0 0 1 0-13zM15.5 15.5 20 20" />}
  {name === 'add' && <path d="M4 4h16v16H4zM12 8v8M8 12h8" />}
  {name === 'profile' && <path d="M12 4a4 4 0 1 1 0 8 4 4 0 0 1 0-8zM4.5 20c1.4-3.3 4.2-5 7.5-5s6.1 1.7 7.5 5" />}
  {name === 'stack' && <path d="M8 3.5h12.5V16M4 7.5h12.5v13H4z" fill={filled ? 'currentColor' : 'none'} />}
  {name === 'back' && <path d="M15 5l-7 7 7 7" />}
  {name === 'close' && <path d="M6 6l12 12M18 6 6 18" />}
  {name === 'swipe' && <path d="M5 12h13M13 7l5 5-5 5" />}
</svg>

<style>
  .igi {
    display: block;
    flex: none;
  }
</style>
