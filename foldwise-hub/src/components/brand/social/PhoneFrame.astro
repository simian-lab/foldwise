---
/**
 * A clean phone: ciruela-shadow body, rounded screen, status bar and, for feed
 * screens, the app's bottom bar. The screen is the default slot. Width comes
 * from --phone-w on the parent (it never exceeds its column).
 */
import IgIcon from './IgIcon.astro';
import IgAvatar from './IgAvatar.astro';

interface Props {
  /** 'light' for feed and posts, 'dark' for stories. */
  tone?: 'light' | 'dark';
  /** Show Instagram's bottom tab bar. */
  nav?: boolean;
  /** Let the screen grow with its content (the profile must show all 9 tiles). */
  fit?: boolean;
  class?: string;
}
const { tone = 'light', nav = tone === 'light', fit = false, class: className } = Astro.props;
---

<div class:list={['phone', `phone--${tone}`, { 'phone--fit': fit }, className]} data-phone>
  <div class="phone__screen">
    <div class="phone__status" aria-hidden="true">
      <span class="phone__time">9:41</span>
      <span class="phone__island"></span>
      <span class="phone__sys">
        <svg viewBox="0 0 18 12" width="17" height="11"><path d="M1 11h2.5V8H1zM5.5 11H8V6H5.5zM10 11h2.5V3.5H10zM14.5 11H17V1h-2.5z" fill="currentColor"></path></svg>
        <svg viewBox="0 0 26 12" width="24" height="11"><rect x="0.75" y="0.75" width="21.5" height="10.5" rx="3" fill="none" stroke="currentColor" stroke-opacity="0.45" stroke-width="1.5"></rect><rect x="2.5" y="2.5" width="16" height="7" rx="1.6" fill="currentColor"></rect><path d="M24 4v4" stroke="currentColor" stroke-opacity="0.45" stroke-width="1.6" stroke-linecap="round"></path></svg>
      </span>
    </div>
    <div class="phone__content">
      <slot />
    </div>
    {
      nav && (
        <div class="phone__nav" aria-hidden="true">
          <IgIcon name="home" size={22} />
          <IgIcon name="search" size={22} />
          <IgIcon name="add" size={22} />
          <IgIcon name="reels" size={22} />
          <IgAvatar size={24} ring="none" />
        </div>
      )
    }
  </div>
</div>

<style>
  .phone {
    --ig-screen: #fffdf8;
    --ig-ink: #2a1430;
    --ig-line: rgb(58 29 63 / 0.12);
    width: min(100%, var(--phone-w, 320px));
    aspect-ratio: 9 / 19.2;
    padding: 9px;
    border-radius: 46px;
    background: var(--c-ciruela-sombra);
    box-shadow:
      inset 0 0 0 1.5px rgb(246 241 231 / 0.14),
      0 28px 50px -22px rgb(42 20 48 / 0.55),
      0 8px 16px -8px rgb(42 20 48 / 0.35);
    container-type: inline-size;
  }
  .phone--fit {
    aspect-ratio: auto;
  }
  .phone--fit .phone__content {
    padding-bottom: 10px;
  }
  .phone__screen {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border-radius: 38px;
    background: var(--ig-screen);
    color: var(--ig-ink);
  }
  .phone--dark .phone__screen {
    background: var(--c-ciruela-sombra);
    color: var(--c-crema);
  }
  .phone__status {
    flex: none;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 40px;
    padding: 0 22px;
    font-family: var(--f-text);
    font-weight: 700;
    font-size: 13px;
  }
  .phone__island {
    width: 78px;
    height: 22px;
    border-radius: 999px;
    background: var(--c-ciruela-sombra);
  }
  .phone--dark .phone__island {
    background: #1d0d22;
  }
  .phone__sys {
    display: flex;
    justify-content: flex-end;
    gap: 5px;
  }
  .phone__content {
    flex: 1;
    min-height: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .phone__nav {
    flex: none;
    display: flex;
    justify-content: space-around;
    align-items: center;
    height: 52px;
    padding-bottom: 8px;
    border-top: 1px solid var(--ig-line);
    background: var(--ig-screen);
  }
</style>
