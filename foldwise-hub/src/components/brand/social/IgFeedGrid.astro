---
/**
 * The @foldwise profile: avatar, name, the tagline as bio, the buttons and the
 * 3 × 3 grid. No follower, post or like counts: there are none to show yet.
 * `annotate` labels each tile with its rhythm (foto, tipografía, patrón).
 */
import IgMedia from './IgMedia.astro';
import IgIcon from './IgIcon.astro';
import IgAvatar from './IgAvatar.astro';
import { feed, SOCIAL_HANDLE, SOCIAL_BIO, type Rhythm } from '../../../data/social';

interface Props {
  /** Show the profile header above the grid. */
  header?: boolean;
  annotate?: boolean;
  class?: string;
}
const { header = true, annotate = false, class: className } = Astro.props;
const rhythmLabel: Record<Rhythm, string> = { foto: 'Foto', tipografia: 'Tipografía', patron: 'Patrón' };
---

<div class:list={['igf', { 'igf--annotated': annotate }, className]} data-ig-feed>
  {
    header && (
      <div class="igf__profile">
        <div class="igf__top" aria-hidden="true">
          <IgIcon name="back" size={20} />
          <span class="igf__title">{SOCIAL_HANDLE}</span>
          <IgIcon name="more" size={20} />
        </div>
        <div class="igf__id">
          <IgAvatar size={64} ring="lima" />
          <div>
            <p class="igf__name">Foldwise</p>
            <p class="igf__cat">Packaging para emprendedores</p>
          </div>
        </div>
        <p class="igf__bio" data-ig-bio>
          {SOCIAL_BIO[0]}
          <br />
          {SOCIAL_BIO[1]}
        </p>
        <div class="igf__buttons" aria-hidden="true">
          <span class="igf__btn igf__btn--main">Seguir</span>
          <span class="igf__btn">Mensaje</span>
        </div>
        <div class="igf__tabs" aria-hidden="true">
          <span class="on">
            <IgIcon name="grid" size={20} />
          </span>
          <span>
            <IgIcon name="reels" size={20} />
          </span>
          <span>
            <IgIcon name="tagged" size={20} />
          </span>
        </div>
      </div>
    )
  }
  <ul class="igf__grid" role="list" aria-label={`Las 9 publicaciones del perfil de ${SOCIAL_HANDLE}`}>
    {
      feed.map((p) => (
        <li class="igf__tile" data-ig-tile={p.id} data-rhythm={p.rhythm}>
          <div class="igf__cell">
            <IgMedia media={p.media} compact />
            {p.carousel && (
              <span class="igf__stack" aria-label="Carrusel">
                <IgIcon name="stack" size={16} />
              </span>
            )}
          </div>
          {annotate && <span class="igf__rhythm">{rhythmLabel[p.rhythm]}</span>}
        </li>
      ))
    }
  </ul>
</div>

<style>
  .igf {
    min-width: 0;
    font-family: var(--f-text);
    color: var(--ig-ink, #2a1430);
  }
  .igf p {
    margin: 0;
  }
  .igf__profile {
    padding: 0 14px;
  }
  .igf__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 4px 0 10px;
  }
  .igf__title {
    font-weight: 700;
    font-size: 15px;
  }
  .igf__id {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .igf__name {
    font-family: var(--f-display);
    font-weight: 800;
    font-size: 17px;
    line-height: 1.1;
  }
  .igf__cat {
    font-size: 12px;
    color: var(--c-ciruela-claro);
  }
  .igf__bio {
    margin-top: 10px !important;
    font-size: 12.5px;
    line-height: 1.4;
  }
  .igf__buttons {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
    margin-top: 12px;
  }
  .igf__btn {
    padding: 7px 0;
    border-radius: 8px;
    text-align: center;
    font-weight: 700;
    font-size: 12.5px;
    background: rgb(58 29 63 / 0.08);
  }
  .igf__btn--main {
    background: var(--c-ciruela);
    color: var(--c-crema);
  }
  .igf__tabs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 12px -14px 0;
    border-top: 1px solid rgb(58 29 63 / 0.12);
  }
  .igf__tabs span {
    display: grid;
    place-items: center;
    padding: 8px 0;
    opacity: 0.45;
  }
  .igf__tabs span.on {
    opacity: 1;
    box-shadow: inset 0 -1.5px 0 currentColor;
  }
  .igf__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2px;
  }
  .igf__tile {
    min-width: 0;
  }
  .igf__cell {
    position: relative;
    aspect-ratio: 1;
  }
  .igf__stack {
    position: absolute;
    top: 6px;
    right: 6px;
    color: #fffdf8;
    filter: drop-shadow(0 1px 2px rgb(42 20 48 / 0.5));
  }
  .igf__rhythm {
    display: block;
    padding-top: 4px;
    font-size: var(--fs-xs);
    font-weight: 600;
  }
  .igf--annotated .igf__grid {
    gap: 10px 6px;
  }
</style>
