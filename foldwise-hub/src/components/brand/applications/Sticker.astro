---
/** Round seal sticker with the tagline around the isotype, plus a lime label sticker. */
import { ISOTYPE_PATH, ISOTYPE_FOLDS } from './iso';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const uid = `st${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  class:list={['app-svg', className]}
  viewBox="0 0 340 240"
  role="img"
  aria-label="Sticker redondo ciruela con el isotipo y el lema, junto a un sticker lima"
  focusable="false"
>
  <defs>
    <filter id={`${uid}-sh`} x="-20%" y="-20%" width="140%" height="150%">
      <feDropShadow dx="0" dy="4" stdDeviation="5" flood-color="#2A1430" flood-opacity="0.2"></feDropShadow>
    </filter>
    <path id={`${uid}-ring`} d="M130 120 m-64 0 a64 64 0 1 1 128 0 a64 64 0 1 1 -128 0"></path>
  </defs>

  <g filter={`url(#${uid}-sh)`}>
    <circle cx="130" cy="120" r="92" fill="#F6F1E7"></circle>
    <circle cx="130" cy="120" r="86" fill="#3A1D3F"></circle>
  </g>
  <circle cx="130" cy="120" r="48" fill="none" stroke="#C8F25A" stroke-width="1.4" stroke-dasharray="4 4"></circle>
  <text fill="#F6F1E7" font-family="'Bricolage Grotesque', sans-serif" font-weight="700" font-size="14.5">
    <textPath href={`#${uid}-ring`} textLength="396" lengthAdjust="spacing">pedidos pequeños · cuidado enorme ·</textPath>
  </text>
  <g transform="translate(103 93) scale(1.18)">
    <path d={ISOTYPE_PATH} fill="#F6F1E7"></path>
    <path d={ISOTYPE_FOLDS} fill="none" stroke="#C8F25A" stroke-width="2" stroke-dasharray="3 2.5"></path>
  </g>

  <g transform="rotate(9 268 176)" filter={`url(#${uid}-sh)`}>
    <rect x="214" y="144" width="108" height="64" rx="14" fill="#C8F25A"></rect>
    <rect x="220" y="150" width="96" height="52" rx="10" fill="none" stroke="#3A1D3F" stroke-width="1" stroke-dasharray="3 3"></rect>
    <text fill="#3A1D3F" font-family="'Bricolage Grotesque', sans-serif" font-weight="800" font-size="15" letter-spacing="-0.5" text-anchor="middle">
      <tspan x="268" y="172">Hecho con</tspan>
      <tspan x="268" y="189">cuidado</tspan>
    </text>
  </g>
</svg>

<style>
  .app-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
</style>
