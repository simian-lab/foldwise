---
/** Delivery van in side elevation, wrapped in the brand. */
import { ISOTYPE_PATH, ISOTYPE_FOLDS } from './iso';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const uid = `dv${Math.random().toString(36).slice(2, 8)}`;
const body =
  'M34 52 Q34 36 50 36 H318 Q334 36 342 48 L380 100 Q386 106 396 108 L438 116 Q452 119 454 134 V178 Q454 188 444 188 H34 Q26 188 26 178 V60 Q26 52 34 52 Z';
const wheels = [112, 380];
---

<svg
  class:list={['app-svg', className]}
  viewBox="0 0 480 240"
  role="img"
  aria-label="Furgoneta de reparto Foldwise en vista lateral"
  focusable="false"
>
  <defs>
    <filter id={`${uid}-blur`} x="-10%" y="-50%" width="120%" height="200%">
      <feGaussianBlur stdDeviation="6"></feGaussianBlur>
    </filter>
    <clipPath id={`${uid}-body`}><path d={body}></path></clipPath>
    <linearGradient id={`${uid}-glass`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#6E4A75"></stop>
      <stop offset="1" stop-color="#3A1D3F"></stop>
    </linearGradient>
    <linearGradient id={`${uid}-shade`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FFFFFF" stop-opacity="0.35"></stop>
      <stop offset="0.5" stop-color="#FFFFFF" stop-opacity="0"></stop>
      <stop offset="1" stop-color="#2A1430" stop-opacity="0.1"></stop>
    </linearGradient>
  </defs>

  <ellipse cx="240" cy="221" rx="214" ry="10" fill="#2A1430" opacity="0.22" filter={`url(#${uid}-blur)`}></ellipse>

  <g clip-path={`url(#${uid}-body)`}>
    <rect x="0" y="0" width="480" height="240" fill="#FBF8F1"></rect>
    <rect x="0" y="150" width="480" height="60" fill="#3A1D3F"></rect>
    <path d="M0 146 H480" stroke="#C8F25A" stroke-width="2" stroke-dasharray="7 5"></path>
    <rect x="0" y="0" width="480" height="240" fill={`url(#${uid}-shade)`}></rect>
    {wheels.map((x) => <circle cx={x} cy="188" r="40" fill="#1E0E22"></circle>)}
    <!-- door seams -->
    <path d="M300 40 V188 M342 50 V188" stroke="#2A1430" stroke-width="1" opacity="0.25"></path>
  </g>
  <path d={body} fill="none" stroke="#2A1430" stroke-width="1" opacity="0.2"></path>

  <!-- windows -->
  <path d="M348 56 L380 102 Q383 106 376 106 H350 Q346 106 346 102 V60 Q346 54 348 56 Z" fill={`url(#${uid}-glass)`}></path>
  <path d="M352 62 L360 72" stroke="#F6F1E7" stroke-width="2" opacity="0.4" stroke-linecap="round"></path>
  <rect x="322" y="118" width="14" height="4" rx="2" fill="#2A1430" opacity="0.5"></rect>
  <!-- headlight and tail light -->
  <path d="M440 124 Q450 126 452 136 H438 Z" fill="#C8F25A"></path>
  <rect x="26" y="70" width="5" height="22" rx="2" fill="#5A3360"></rect>
  <!-- mirror -->
  <path d="M378 86 h10 v14 h-8 z" fill="#2A1430"></path>

  <!-- branding -->
  <g transform="translate(56 66) scale(1.3)">
    <path d={ISOTYPE_PATH} fill="#3A1D3F"></path>
    <path d={ISOTYPE_FOLDS} fill="none" stroke="#C8F25A" stroke-width="2" stroke-dasharray="3 2.5"></path>
  </g>
  <text x="120" y="112" fill="#3A1D3F" font-family="'Bricolage Grotesque', sans-serif" font-weight="800" font-size="52" letter-spacing="-1.8">foldwise</text>
  <text x="123" y="134" fill="#5A3360" font-family="'Figtree', sans-serif" font-weight="600" font-size="13">Pedidos pequeños. Cuidado enorme.</text>
  <text x="246" y="176" text-anchor="middle" fill="#F6F1E7" font-family="'Figtree', sans-serif" font-weight="600" font-size="11" opacity="0.8">foldwise.com</text>

  <!-- wheels -->
  {wheels.map((x) => (
    <g>
      <circle cx={x} cy="188" r="34" fill="#2A1430"></circle>
      <circle cx={x} cy="188" r="26" fill="#1E0E22"></circle>
      <circle cx={x} cy="188" r="13" fill="#E2C7A0"></circle>
      <circle cx={x} cy="188" r="4" fill="#A9845E"></circle>
    </g>
  ))}
</svg>

<style>
  .app-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
</style>
