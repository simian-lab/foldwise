---
/**
 * Open kraft mailer with a ciruela printed interior and the welcome message on
 * the inside of the lid: the moment the customer opens the box.
 */
import { iso, poly, line, faceMatrix, add, scale, fit, ISOTYPE_PATH, ISOTYPE_FOLDS, TONES } from './iso';
import type { V3 } from './iso';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;

const L = 240; // x
const W = 170; // y
const H = 56; // z
const t = 5; // board thickness
const K = TONES.kraft;
const P = TONES.ciruela;

// Lid hinged on the back edge (y = 0), opened past vertical.
const th = (108 * Math.PI) / 180;
const es: V3 = [0, Math.cos(th), Math.sin(th)]; // along the lid, hinge -> front edge
const nIn: V3 = [0, Math.sin(th), -Math.cos(th)]; // printed side normal
const lidPt = (x: number, s: number, n = 0): V3 => add(add([x, 0, H], scale(es, s)), scale(nIn, n));
const lidFace = [lidPt(0, 0), lidPt(L, 0), lidPt(L, W), lidPt(0, W)];
const lidEdge = [lidPt(L, 0), lidPt(L, W), lidPt(L, W, -t), lidPt(L, 0, -t)];

// Tuck flap on the lid's front edge, folded 30° toward the printed side.
const phi = (30 * Math.PI) / 180;
const fd: V3 = add(scale(es, Math.cos(phi)), scale(nIn, Math.sin(phi)));
const FL = 40;
const flapBase = (x: number) => lidPt(x, W);
const flapTip = (x: number) => add(lidPt(x, W), scale(fd, FL));
const flap = [flapBase(0), flapBase(L), flapTip(L - 18), flapTip(18)];
const flapEdge = [flapBase(L), flapTip(L - 18), add(flapTip(L - 18), scale(nIn, -t)), add(flapBase(L), scale(nIn, -t))];

// Tray.
const backInnerY = [[t, t, t], [L - t, t, t], [L - t, t, H], [t, t, H]] as V3[];
const backInnerX = [[t, t, t], [t, W - t, t], [t, W - t, H], [t, t, H]] as V3[];
const floor = [[t, t, t], [L - t, t, t], [L - t, W - t, t], [t, W - t, t]] as V3[];
const front = [[0, W, 0], [L, W, 0], [L, W, H], [0, W, H]] as V3[];
const right = [[L, 0, 0], [L, W, 0], [L, W, H], [L, 0, H]] as V3[];
const rim =
  poly([[0, 0, H], [L, 0, H], [L, W, H], [0, W, H]]) + poly([[t, t, H], [t, W - t, H], [L - t, W - t, H], [L - t, t, H]]);

// Contents: folded tissue on the floor and a lime seal.
const tissue = [[28, 26, t + 1], [L - 34, 26, t + 1], [L - 34, W - 22, t + 1], [28, W - 22, t + 1]] as V3[];
const tissueFold = line([[28 + (L - 62) / 2, 26, t + 1], [28 + (L - 62) / 2, W - 22, t + 1]]);
const sealC: V3 = [28 + (L - 62) / 2, (26 + W - 22) / 2 + 8, t + 1.5];

const shadow = poly([[-14, -8, 0], [L + 22, -8, 0], [L + 22, W + 22, 0], [-14, W + 22, 0]]);

const viewBox = fit([...lidFace, flapTip(18), flapTip(L - 18), [0, W + 22, 0], [L + 22, W + 22, 0], [L + 22, -8, 0]], 10);
const uid = `mi${Math.random().toString(36).slice(2, 8)}`;

const lidMatrix = faceMatrix(lidPt(0, W), [1, 0, 0], scale(es, -1));
const frontMatrix = faceMatrix([0, W, H], [1, 0, 0], [0, 0, -1]);
const sealMatrix = faceMatrix(sealC, [1, 0, 0], [0, 1, 0]);
---

<svg
  class:list={['app-svg', className]}
  viewBox={viewBox}
  role="img"
  aria-label="Caja mailer kraft abierta con el interior ciruela y un mensaje de bienvenida en la tapa"
  focusable="false"
>
  <defs>
    <filter id={`${uid}-blur`} x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="9"></feGaussianBlur>
    </filter>
    <linearGradient id={`${uid}-lid`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#4A2850"></stop>
      <stop offset="1" stop-color="#341A39"></stop>
    </linearGradient>
  </defs>

  <path d={shadow} fill="#2A1430" opacity="0.16" filter={`url(#${uid}-blur)`}></path>

  <!-- lid -->
  <path d={poly(lidEdge)} fill={K.right}></path>
  <path d={poly(lidFace)} fill={`url(#${uid}-lid)`}></path>
  <path d={poly(flapEdge)} fill={K.right}></path>
  <path d={poly(flap)} fill={P.top}></path>
  <path d={line([flapBase(0), flapBase(L)])} stroke="#C8F25A" stroke-width="1.4" stroke-dasharray="5 4" fill="none"></path>

  <g transform={lidMatrix} data-part="inner-message">
    <g transform="translate(24 22) scale(0.72)">
      <path d={ISOTYPE_PATH} fill="#F6F1E7"></path>
      <path d={ISOTYPE_FOLDS} fill="none" stroke="#C8F25A" stroke-width="2.2" stroke-dasharray="3 2.5"></path>
    </g>
    <text x="24" y="98" fill="#F6F1E7" font-family="'Bricolage Grotesque', sans-serif" font-weight="800" font-size="42" letter-spacing="-1.4">Hola.</text>
    <text fill="#F6F1E7" font-family="'Figtree', sans-serif" font-weight="600" font-size="17">
      <tspan x="24" y="126">Esto lo empacamos</tspan>
      <tspan x="24" y="147">pensando en ti.</tspan>
    </text>
    <path d="M168 150h48" stroke="#C8F25A" stroke-width="1.6" stroke-dasharray="4 3"></path>
  </g>

  <!-- tray interior -->
  <path d={poly(backInnerY)} fill={P.left}></path>
  <path d={poly(backInnerX)} fill={P.right}></path>
  <path d={poly(floor)} fill={P.top}></path>
  <path d={poly(tissue)} fill="#EDE5D6"></path>
  <path d={poly([[28 + (L - 62) / 2, 26, t + 1], [L - 34, 26, t + 1], [L - 34, W - 22, t + 1], [28 + (L - 62) / 2, W - 22, t + 1]])} fill="#E3D9C7"></path>
  <path d={tissueFold} stroke="#CFC2AB" stroke-width="1"></path>
  <g transform={sealMatrix}>
    <circle r="19" fill="#C8F25A"></circle>
    <circle r="15.5" fill="none" stroke="#3A1D3F" stroke-width="0.8" stroke-dasharray="2 2"></circle>
    <g transform="translate(-9.5 -9.5) scale(0.42)">
      <path d={ISOTYPE_PATH} fill="#3A1D3F"></path>
    </g>
  </g>

  <!-- tray outside -->
  <path d={poly(front)} fill={K.left}></path>
  <path d={poly(right)} fill={K.right}></path>
  <path d={rim} fill={K.top} fill-rule="evenodd"></path>
  <path d={line([[L, W, 0], [L, W, H]])} stroke={K.edge} stroke-width="0.8" opacity="0.6"></path>

  <g transform={frontMatrix}>
    <g transform="translate(20 15) scale(0.5)">
      <path d={ISOTYPE_PATH} fill="#3A1D3F"></path>
      <path d={ISOTYPE_FOLDS} fill="none" stroke="#C8F25A" stroke-width="2.2" stroke-dasharray="3 2.5"></path>
    </g>
    <text x="46" y="34" fill="#3A1D3F" font-family="'Bricolage Grotesque', sans-serif" font-weight="800" font-size="17" letter-spacing="-0.6">foldwise</text>
  </g>
</svg>

<style>
  .app-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
</style>
