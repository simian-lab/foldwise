---
/**
 * Kraft shipping box (RSC) wrapped in a ciruela belly band, sealed with lime
 * tape along the flap seam, with a shipping label.
 */
import { poly, line, faceMatrix, fit, ISOTYPE_PATH, ISOTYPE_FOLDS, TONES } from './iso';
import type { V3 } from './iso';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;

const L = 200;
const W = 150;
const H = 150;
const K = TONES.kraft;
const P = TONES.ciruela;
const b0 = 44; // band bottom
const b1 = 92; // band top
const tw = 14; // half tape width
const tapeDrop = 38;

const top = [[0, 0, H], [L, 0, H], [L, W, H], [0, W, H]] as V3[];
const left = [[0, W, 0], [L, W, 0], [L, W, H], [0, W, H]] as V3[];
const right = [[L, 0, 0], [L, W, 0], [L, W, H], [L, 0, H]] as V3[];
const bandLeft = [[0, W, b0], [L, W, b0], [L, W, b1], [0, W, b1]] as V3[];
const bandRight = [[L, 0, b0], [L, W, b0], [L, W, b1], [L, 0, b1]] as V3[];
const tapeTop = [[0, W / 2 - tw, H], [L, W / 2 - tw, H], [L, W / 2 + tw, H], [0, W / 2 + tw, H]] as V3[];
const tapeRight = [[L, W / 2 - tw, H], [L, W / 2 + tw, H], [L, W / 2 + tw, H - tapeDrop], [L, W / 2 - tw, H - tapeDrop]] as V3[];
const seam = line([[0, W / 2, H], [L, W / 2, H]]);
const shadow = poly([[-16, -10, 0], [L + 30, -10, 0], [L + 30, W + 30, 0], [-16, W + 30, 0]]);
const viewBox = fit([...top, [0, W, 0], [L, W, 0], [L, 0, 0], [L + 30, W + 30, 0], [-16, W + 30, 0], [L + 30, -10, 0]], 8);
const uid = `sb${Math.random().toString(36).slice(2, 8)}`;

const bandLeftM = faceMatrix([0, W, b1], [1, 0, 0], [0, 0, -1]);
const bandRightM = faceMatrix([L, W, b1], [0, -1, 0], [0, 0, -1]);
const tapeTopM = faceMatrix([0, W / 2 - tw, H], [1, 0, 0], [0, 1, 0]);
const labelM = faceMatrix([L, 52, H - 10], [0, -1, 0], [0, 0, -1]);
---

<svg
  class:list={['app-svg', className]}
  viewBox={viewBox}
  role="img"
  aria-label="Caja de envío kraft con banda ciruela, cinta lima y etiqueta de envío"
  focusable="false"
>
  <defs>
    <filter id={`${uid}-blur`} x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="9"></feGaussianBlur>
    </filter>
  </defs>
  <path d={shadow} fill="#2A1430" opacity="0.18" filter={`url(#${uid}-blur)`}></path>

  <path d={poly(left)} fill={K.left}></path>
  <path d={poly(right)} fill={K.right}></path>
  <path d={poly(top)} fill={K.top}></path>
  <path d={seam} stroke={K.edge} stroke-width="1.2" opacity="0.7"></path>
  <path d={line([[L, W, 0], [L, W, H]])} stroke={K.edge} stroke-width="0.8" opacity="0.5"></path>

  <g data-part="band">
    <path d={poly(bandLeft)} fill={P.left}></path>
    <path d={poly(bandRight)} fill={P.right}></path>
    <g transform={bandLeftM}>
      <g transform="translate(18 10) scale(0.62)">
        <path d={ISOTYPE_PATH} fill="#F6F1E7"></path>
        <path d={ISOTYPE_FOLDS} fill="none" stroke="#C8F25A" stroke-width="2.2" stroke-dasharray="3 2.5"></path>
      </g>
      <text x="50" y="33" fill="#F6F1E7" font-family="'Bricolage Grotesque', sans-serif" font-weight="800" font-size="24" letter-spacing="-0.84">foldwise</text>
    </g>
    <g transform={bandRightM}>
      <text x="20" y="30" fill="#F6F1E7" font-family="'Figtree', sans-serif" font-weight="600" font-size="14">Cuidado enorme.</text>
    </g>
  </g>

  <!-- shipping label -->
  <g transform={labelM}>
    <rect width="44" height="40" rx="3" fill="#F6F1E7"></rect>
    <g transform="translate(5 5) scale(0.26)"><path d={ISOTYPE_PATH} fill="#3A1D3F"></path></g>
    <path d="M20 9h18 M20 15h12 M6 24h32 M6 29h24 M6 34h28" stroke="#3A1D3F" stroke-width="1.6" opacity="0.55"></path>
  </g>

  <!-- tape -->
  <path d={poly(tapeTop)} fill="#C8F25A"></path>
  <path d={poly(tapeRight)} fill="#AED645"></path>
  <g transform={tapeTopM}>
    {[14, 74, 134].map((x) => (
      <text x={x} y="18.5" fill="#3A1D3F" font-family="'Bricolage Grotesque', sans-serif" font-weight="800" font-size="11" letter-spacing="-0.4">foldwise</text>
    ))}
  </g>
</svg>

<style>
  .app-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
</style>
