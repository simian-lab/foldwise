---
/** Lime packing tape: a roll with a printed strip pulled out across the table. */
import { ISOTYPE_PATH } from './iso';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const uid = `tp${Math.random().toString(36).slice(2, 8)}`;
const rings = [76, 71, 66, 61, 56, 51];
---

<svg
  class:list={['app-svg', className]}
  viewBox="0 0 340 230"
  role="img"
  aria-label="Rollo de cinta de embalaje lima con la marca impresa"
  focusable="false"
>
  <defs>
    <filter id={`${uid}-blur`} x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="7"></feGaussianBlur>
    </filter>
    <clipPath id={`${uid}-strip`}>
      <path d="M96 166 L326 152 L322 166 L330 172 L320 178 L328 186 L104 202 Z"></path>
    </clipPath>
  </defs>

  <ellipse cx="190" cy="196" rx="150" ry="16" fill="#2A1430" opacity="0.14" filter={`url(#${uid}-blur)`}></ellipse>

  <!-- strip on the table -->
  <g clip-path={`url(#${uid}-strip)`}>
    <rect x="80" y="140" width="260" height="70" fill="#C8F25A"></rect>
    <g transform="rotate(-3.5 200 176)">
      {[160, 252].map((x) => (
        <g>
          <g transform={`translate(${x - 16} 168) scale(0.3)`}><path d={ISOTYPE_PATH} fill="#3A1D3F"></path></g>
          <text x={x} y="182" fill="#3A1D3F" font-family="'Bricolage Grotesque', sans-serif" font-weight="800" font-size="15" letter-spacing="-0.5">foldwise</text>
        </g>
      ))}
    </g>
    <path d="M96 166 L326 152" stroke="#A9C93F" stroke-width="2"></path>
  </g>

  <!-- roll: back rim, body, front face -->
  <ellipse cx="128" cy="104" rx="56" ry="80" fill="#9EC23A"></ellipse>
  <rect x="104" y="24" width="24" height="160" fill="#B3DA48"></rect>
  <path d="M104 24 H128 M104 184 H128" stroke="#9EC23A" stroke-width="0"></path>
  <ellipse cx="104" cy="104" rx="56" ry="80" fill="#C8F25A"></ellipse>
  {rings.map((r) => (
    <ellipse cx="104" cy="104" rx={r * 0.7} ry={r} fill="none" stroke="#AED645" stroke-width="0.8"></ellipse>
  ))}
  <ellipse cx="104" cy="104" rx="33" ry="47" fill="#C9A27A"></ellipse>
  <ellipse cx="104" cy="104" rx="27" ry="39" fill="#A9845E"></ellipse>
  <ellipse cx="110" cy="104" rx="25" ry="38" fill="#5E4530"></ellipse>
  <path d="M104 184 Q96 196 104 202" fill="none" stroke="#AED645" stroke-width="2"></path>
</svg>

<style>
  .app-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
</style>
