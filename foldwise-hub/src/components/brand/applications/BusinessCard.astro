---
/** Business card, front (ciruela) and back (crema), 3.5 × 2 in. */
import { ISOTYPE_PATH, ISOTYPE_FOLDS } from './iso';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const uid = `bc${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  class:list={['app-svg', className]}
  viewBox="0 0 340 240"
  role="img"
  aria-label="Tarjeta de presentación Foldwise, frente ciruela y reverso crema"
  focusable="false"
>
  <defs>
    <filter id={`${uid}-sh`} x="-20%" y="-20%" width="140%" height="160%">
      <feDropShadow dx="0" dy="5" stdDeviation="6" flood-color="#2A1430" flood-opacity="0.2"></feDropShadow>
    </filter>
  </defs>

  <!-- back -->
  <g transform="rotate(4 220 80)" filter={`url(#${uid}-sh)`}>
    <rect x="112" y="16" width="210" height="120" rx="6" fill="#FBF8F1"></rect>
    <g transform="translate(130 30) scale(0.42)"><path d={ISOTYPE_PATH} fill="#3A1D3F"></path></g>
    <text x="130" y="68" fill="#3A1D3F" font-family="'Bricolage Grotesque', sans-serif" font-weight="800" font-size="17" letter-spacing="-0.5">Valentina Ríos</text>
    <text x="130" y="83" fill="#5A3360" font-family="'Figtree', sans-serif" font-size="10">Tu asesora de packaging</text>
    <path d="M130 94 H304" stroke="#3A1D3F" stroke-width="0.8" stroke-dasharray="3 3" opacity="0.4"></path>
    <text fill="#3A1D3F" font-family="'Figtree', sans-serif" font-size="9" font-weight="600">
      <tspan x="234" y="108">hola@foldwise.com</tspan>
      <tspan x="234" y="122">(512) 555-0142</tspan>
    </text>
  </g>

  <!-- front -->
  <g transform="rotate(-4 120 170)" filter={`url(#${uid}-sh)`}>
    <rect x="18" y="112" width="210" height="120" rx="6" fill="#3A1D3F"></rect>
    <path d="M18 204 H228" stroke="#C8F25A" stroke-width="1.2" stroke-dasharray="4 4"></path>
    <g transform="translate(58 149) scale(0.78)">
      <path d={ISOTYPE_PATH} fill="#F6F1E7"></path>
      <path d={ISOTYPE_FOLDS} fill="none" stroke="#C8F25A" stroke-width="2.2" stroke-dasharray="3 2.5"></path>
    </g>
    <text x="98" y="180" fill="#F6F1E7" font-family="'Bricolage Grotesque', sans-serif" font-weight="800" font-size="27" letter-spacing="-0.95">foldwise</text>
  </g>
</svg>

<style>
  .app-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
</style>
