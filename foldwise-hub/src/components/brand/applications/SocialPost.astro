---
/** A feed post in the brand's voice: one message, one box, the 80/20 rule. */
import Isotype from '../Isotype.astro';
import IsoBox from '../../boxes/IsoBox.astro';
import { minOrderUnits } from '../../../data/categories';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={['post', className]} role="img" aria-label="Publicación de redes sociales de Foldwise">
  <div class="post__head" aria-hidden="true">
    <span class="post__avatar"><Isotype variant="ciruela" size={18} label="" /></span>
    <span class="post__handle">foldwise</span>
    <svg class="post__more" viewBox="0 0 20 4" width="18" height="4"><circle cx="2" cy="2" r="2"></circle><circle cx="10" cy="2" r="2"></circle><circle cx="18" cy="2" r="2"></circle></svg>
  </div>
  <div class="post__media" aria-hidden="true">
    <p class="post__headline">Tu primera caja también cuenta.</p>
    <span class="post__chip">Desde {minOrderUnits} cajas</span>
    <div class="post__box">
      <IsoBox style="mailer" l={12} w={9} h={4} colorway="kraft" branding="foldwise" open label="" />
    </div>
  </div>
  <div class="post__foot" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
      <path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z" fill="#C8F25A" stroke="#3A1D3F"></path>
    </svg>
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
      <path d="M20 12a8 8 0 0 1-11.6 7.1L4 20l1-4.2A8 8 0 1 1 20 12z"></path>
    </svg>
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
      <path d="M21 4 3 11l7 2 2 7z M10 13l4-4"></path>
    </svg>
  </div>
  <p class="post__caption" aria-hidden="true">
    <b>foldwise</b> Empieza con {minOrderUnits} cajas. Cuando crezcas, el precio baja contigo.
  </p>
</div>

<style>
  .post {
    background: #fbf8f1;
    border-radius: var(--r-md);
    box-shadow: 0 10px 30px -14px rgb(42 20 48 / 0.35);
    overflow: hidden;
    width: 100%;
    max-width: 300px;
    margin-inline: auto;
    font-size: 12px;
    line-height: 1.4;
  }
  .post__head {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
  }
  .post__avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--c-ciruela);
    display: grid;
    place-items: center;
    box-shadow: 0 0 0 2px #fbf8f1, 0 0 0 3.5px var(--c-lima);
  }
  .post__handle {
    font-weight: 700;
    flex: 1;
  }
  .post__more {
    fill: var(--c-ciruela);
    opacity: 0.6;
  }
  .post__media {
    position: relative;
    aspect-ratio: 4 / 5;
    background: var(--c-ciruela);
    color: var(--c-crema);
    padding: 18px 18px 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .post__headline {
    margin: 0;
    font-family: var(--f-display);
    font-weight: 800;
    font-size: 27px;
    line-height: 1;
    letter-spacing: -0.035em;
    max-width: 9ch;
  }
  .post__box {
    margin-top: auto;
    margin-inline: -10px;
    transform: translateY(8%);
  }
  .post__chip {
    align-self: flex-start;
    margin-top: 10px;
    background: var(--c-lima);
    color: var(--c-ciruela);
    font-weight: 700;
    font-size: 10.5px;
    padding: 4px 9px;
    border-radius: var(--r-pill);
    transform: rotate(-4deg);
  }
  .post__foot {
    display: flex;
    gap: 12px;
    padding: 9px 10px 2px;
    color: var(--c-ciruela);
  }
  .post__caption {
    margin: 0;
    padding: 2px 10px 12px;
  }
</style>
