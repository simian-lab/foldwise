---
/** Thank-you card that travels inside every order, over its kraft envelope. */
import { ISOTYPE_PATH, ISOTYPE_FOLDS } from './iso';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const uid = `ty${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  class:list={['app-svg', className]}
  viewBox="0 0 340 240"
  role="img"
  aria-label="Tarjeta de agradecimiento crema sobre su sobre kraft"
  focusable="false"
>
  <defs>
    <filter id={`${uid}-sh`} x="-20%" y="-20%" width="140%" height="160%">
      <feDropShadow dx="0" dy="6" stdDeviation="7" flood-color="#2A1430" flood-opacity="0.18"></feDropShadow>
    </filter>
  </defs>

  <!-- envelope -->
  <g transform="rotate(7 200 120)" filter={`url(#${uid}-sh)`}>
    <rect x="100" y="38" width="220" height="146" rx="4" fill="#C9A27A"></rect>
    <path d="M100 38 L210 112 L320 38" fill="none" stroke="#A9845E" stroke-width="1.6"></path>
    <circle cx="210" cy="112" r="11" fill="#C8F25A"></circle>
    <g transform="translate(204.5 106.5) scale(0.24)"><path d={ISOTYPE_PATH} fill="#3A1D3F"></path></g>
  </g>

  <!-- card -->
  <g transform="rotate(-4 130 130)" filter={`url(#${uid}-sh)`}>
    <rect x="22" y="58" width="226" height="150" rx="4" fill="#FBF8F1"></rect>
    <g transform="translate(40 74) scale(0.5)">
      <path d={ISOTYPE_PATH} fill="#3A1D3F"></path>
      <path d={ISOTYPE_FOLDS} fill="none" stroke="#C8F25A" stroke-width="2.2" stroke-dasharray="3 2.5"></path>
    </g>
    <text fill="#3A1D3F" font-family="'Bricolage Grotesque', sans-serif" font-weight="800" font-size="21" letter-spacing="-0.7">
      <tspan x="40" y="128">Gracias por empezar</tspan>
      <tspan x="40" y="151">con nosotros.</tspan>
    </text>
    <text fill="#5A3360" font-family="'Figtree', sans-serif" font-size="10.5">
      <tspan x="40" y="174">Revisamos cada caja antes de enviarla.</tspan>
      <tspan x="40" y="188">Si algo no te encanta, escríbenos.</tspan>
    </text>
    <path d="M196 200 c5-8 10-8 12-2 s7 5 12-3" fill="none" stroke="#3A1D3F" stroke-width="1.4" stroke-linecap="round"></path>
  </g>
</svg>

<style>
  .app-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
</style>
