---
import '../styles/tokens.css';
import '../styles/global.css';
import HubNav from '../components/hub/HubNav.astro';
import { taglines } from '../data/brand';

interface Props {
  title: string;
  description?: string;
  /** Tone of the hub bar; the shop uses "paper" so it never doubles its promo bar. */
  navTone?: 'dark' | 'paper';
}

const { title, description = taglines.principal, navTone = 'dark' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/bricolage-grotesque-latin-800-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/figtree-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
  </head>
  <body>
    <HubNav tone={navTone} />
    <slot />
  </body>
</html>
